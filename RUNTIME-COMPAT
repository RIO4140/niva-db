# توافق NivaDB مع بيئة تشغيل Niva
#
# كل إصدار من NivaDB مربوط بإصدار Runtime متوافق من لغة Niva.
# إدارة إصدارات NivaDB مستقلة تماما عن إصدارات اللغة.

# الإصدار المثبّت الآن (ينزّله tools/تمهيد.sh):
#   NivaDB v0.1.0-dev  ←  Niva v1.2.2 (الرأس 84fa6364)
#   أصول الإصدار v1.2.2 (كما هي فعلا في GitHub — البادئة العربية «نيفا» سقطت
#   من أسماء ثنائيات CLI في مهمة النشر؛ وهذه هي الأسماء الحقيقية):
#     لينكس:   default.-linux-x86_64   (6,210,512 بايت)
#     ماك:     default.-macos-x86_64   (5,218,704 بايت)
#     ويندوز:  -windows-x86_64.exe     (4,877,312 بايت)
#   + niva-terminal-1.2.2.apk (ترمنال أندرويد — ليس Runtime لسطح المكتب)

# المحرك المستهدف لـ NivaDB v0.1:
#   رأس cbab4979 (المهام 1–26، CI أخضر على المنصات الثلاث)
#   — أحدث من ثنائي v1.2.2 (الرأس 84fa6364، حتى المهمة 20).
#   الفارق بينهما: المهام 21–26 (نبّه، نزّل+إلغاء، نطق، صوت، حساس، اسمع+بطارية)
#   — وهي قدرات جهاز أندرويد لا يحتاجها Core على سطح المكتب،
#   فثنائي v1.2.2 كافٍ للمرحلة الأولى كاملة.

# أين يثبَّت الثنائي (إصلاح 2026-11-07 — فخ التمهيد):
#   tools/تمهيد.sh ينزّل الثنائي إلى niva-bin/ داخل المستودع فقط،
#   ولا يكتب في ~/.local/bin إطلاقا (الكتابة هناك كانت تكتب فوق ثنائي
#   مطوّر مثبّت بلا تحذير — حدث فعلا مع ثنائي المهمة 28).
#   وtools/شغّل-الاختبارات.sh يقدّم niva-bin/نيفا إن وُجد، ثم نيفا من
#   PATH، ثم ~/.local/bin/نيفا. وniva-bin/ مغطى بـ .gitignore (لا يُدفع).

# مسار الترقية:
#   إرفاق ثنائي CLI جديد مبني من رأس أحدث إلى إصدار niva (وسم جديد)
#   يحتاج أمرا منفصلا من المالك — لا ينفَّذ تلقائيا.
#   حين يصدر إصدار CLI أحدث، حدّث هذا الملف + tools/تمهيد.sh بالإصدار الجديد،
#   وأعد تشغيل التمهيد والاختبارات كاملة قبل اعتماده.
#   ويمكن تثبيت ثنائي معين يدويا عبر: NIVA_RUNTIME_URL=<رابط الثنائي> sh tools/تمهيد.sh

NIVADB_VERSION=v0.1.0-dev
NIVA_RUNTIME_VERSION=v1.2.2
NIVA_RUNTIME_HEAD=84fa6364
NIVA_TARGET_HEAD=cbab4979
