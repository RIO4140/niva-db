# مثال أول — NivaDB Core v0.1
# قاعدة مكتبة صغيرة: إنشاء وإدخال وبحث وفهرس وحفظ وإعادة فتح.
# التشغيل من مجلد المستودع: نيفا src/مثال-أول.نيفا
# (أو من داخل src/‏: نيفا مثال-أول.نيفا)
استورد قاعدة

دالة مقروء(صف_مثال):
    ارجع صف_مثال["مقروء"] == صحيح

قاعدة.احذف_قاعدة("قاعدة-مثال")
قاعدة.أنشئ_قاعدة("قاعدة-مثال")
مخطط = [["عنوان", "نص"], ["سنة", "عدد"], ["مقروء", "منطقي"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-مثال", "كتب", مخطط)
جدول = ظرف["قيمة"]

كتب = [["الأيام", ١٩٢٩, صحيح], ["دعاء الكروان", ١٩٣٤, صحيح], ["الثلاثية", ١٩٥٧, خطأ]]
لكل كتاب_مثال في كتب:
    ظرف = قاعدة.أدخل(جدول, {"عنوان": كتاب_مثال[٠], "سنة": كتاب_مثال[١], "مقروء": كتاب_مثال[٢]})
    جدول = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.اختر(جدول, مقروء)
اطبع "الكتب المقروءة: " + نص(طول(ظرف["قيمة"]))

ظرف = قاعدة.أنشئ_فهرس(جدول, "سنة")
جدول = ظرف["قيمة"]
ظرف = قاعدة.ابحث_بالفهرس(جدول, "سنة", ١٩٣٤)
اطبع "كتاب سنة ١٩٣٤: " + ظرف["قيمة"][٠]["عنوان"]

ظرف = قاعدة.احفظ(جدول)
جدول = ظرف["قيمة"]
ظرف = قاعدة.افتح_جدول("قاعدة-مثال", "كتب")
جدول٢ = ظرف["قيمة"]
اطبع "الصفوف بعد إعادة الفتح: " + نص(طول(جدول٢["صفوف"]))
اطبع "التالي: " + نص(جدول٢["التالي"])
اطبع "تم"
