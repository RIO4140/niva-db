# وحدة نتيجة — ظرفا النجاح والفشل
# كل دالة عامة في NivaDB ترجع ظرفا بهذا الشكل:
#   {"نجاح": منطقي, "قيمة": أي, "خطأ": نص}
# نجاحا تكون "قيمة" هي النتيجة و"خطأ" نصا فارغا،
# وفشلا تكون "قيمة" لاشيء و"خطأ" رسالة عربية.

صدر ناجح
دالة ناجح(قيمة_نتيجة):
    ارجع {"نجاح": صحيح, "قيمة": قيمة_نتيجة, "خطأ": ""}

صدر فاشل
دالة فاشل(خطأ_نتيجة):
    ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": خطأ_نتيجة}
