# وحدة فهرس — فهرس قاموس في الذاكرة وملف نصي
# البنية: {"مفاتيح": [مفتاح...], "قيم": {مفتاح: [معرف...]}}
# القائمة الموازية لأن قواميس نيفا لا تُكرَّر ولا تُحصى مفاتيحها.
# المفتاح هو نص التشفير نفسه (ترميز.شفّر_قيمة).

# --- فهرس فارغ جديد ---
صدر جديد
دالة جديد():
    ارجع {"مفاتيح": [], "قيم": {}}

# --- إضافة معرف إلى مفتاح (وظيفي: يرجع الفهرس المحدَّث) ---
صدر أضف
دالة أضف(فهرس_أضف، مفتاح_أضف، معرف_أضف):
    قيم_أضف = فهرس_أضف["قيم"]
    إذا مفتاح_أضف في قيم_أضف:
        قائمة_أضف = قيم_أضف[مفتاح_أضف]
        قائمة_أضف.أضف(معرف_أضف)
        قيم_أضف[مفتاح_أضف] = قائمة_أضف
    وإلا:
        قائمة_أضف = []
        قائمة_أضف.أضف(معرف_أضف)
        قيم_أضف[مفتاح_أضف] = قائمة_أضف
        مفاتيح_أضف = فهرس_أضف["مفاتيح"]
        مفاتيح_أضف.أضف(مفتاح_أضف)
        فهرس_أضف["مفاتيح"] = مفاتيح_أضف
    فهرس_أضف["قيم"] = قيم_أضف
    ارجع فهرس_أضف

# --- سحب معرف من مفتاح (وظيفي) ---
# مفتاح بلا معرفات يبقى بقائمة فارغة (لا حذف لمفاتيح القواميس).
صدر اسحب
دالة اسحب(فهرس_اسح، مفتاح_اسح، معرف_اسح):
    قيم_اسح = فهرس_اسح["قيم"]
    إذا مفتاح_اسح في قيم_اسح:
        قائمة_اسح = قيم_اسح[مفتاح_اسح]
        جديدة_اسح = []
        لكل معرف_حلقة_اسح في قائمة_اسح:
            إذا معرف_حلقة_اسح != معرف_اسح:
                جديدة_اسح.أضف(معرف_حلقة_اسح)
        قيم_اسح[مفتاح_اسح] = جديدة_اسح
        فهرس_اسح["قيم"] = قيم_اسح
    ارجع فهرس_اسح

# --- معرفات مفتاح (قائمة فارغة إن غاب) ---
صدر ابحث
دالة ابحث(فهرس_ابح، مفتاح_ابح):
    قيم_ابح = فهرس_ابح["قيم"]
    إذا مفتاح_ابح في قيم_ابح:
        ارجع قيم_ابح[مفتاح_ابح]
    فارغة_ابح = []
    ارجع فارغة_ابح

# --- ترميز الفهرس إلى نص ملف: مفتاح|معرف,معرف,... ---
# المفاتيح بلا معرفات تُسقَط من الملف (تُعاد عند الفتح من الصفوف).
صدر شفّر
دالة شفّر(فهرس_شف):
    نص_شف = ""
    لكل مفتاح_شف في فهرس_شف["مفاتيح"]:
        قائمة_شف = فهرس_شف["قيم"][مفتاح_شف]
        إذا طول(قائمة_شف) == ٠:
            تابع
        نص_شف = نص_شف + مفتاح_شف + "|"
        عداد_شف = ٠
        بينما عداد_شف < طول(قائمة_شف):
            إذا عداد_شف > ٠:
                نص_شف = نص_شف + ","
            نص_شف = نص_شف + نص(قائمة_شف[عداد_شف])
            عداد_شف = عداد_شف + ١
        نص_شف = نص_شف + "\n"
    ارجع نص_شف

# --- فك سطور ملف الفهرس إلى ظرف بالفهرس ---
صدر فكّ
دالة فكّ(سطور_فكف):
    فهرس_فكف = جديد()
    لكل سطر_فكف في سطور_فكف:
        أجزاء_فكف = سطر_فكف.قسم("|")
        إذا طول(أجزاء_فكف) != ٢:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "سطر فهرس تالف"}
        مفتاح_فكف = أجزاء_فكف[٠]
        إذا أجزاء_فكف[١] == "":
            تابع
        معرفات_فكف = أجزاء_فكف[١].قسم(",")
        لكل نص_معرف_فكف في معرفات_فكف:
            حاول:
                معرف_فكف = عدد(نص_معرف_فكف)
            ماعدا:
                ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "معرف غير صالح في ملف الفهرس"}
            إذا معرف_فكف < ١:
                ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "معرف أقل من ١ في ملف الفهرس"}
            فهرس_فكف = أضف(فهرس_فكف, مفتاح_فكف, معرف_فكف)
    ارجع {"نجاح": صحيح, "قيمة": فهرس_فكف, "خطأ": ""}
