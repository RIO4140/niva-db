# وحدة ترميز — ترميز القيم والصفوف والمخططات وفكها
# الصيغة موثقة في docs/تصميم-المرحلة-الأولى.md §4.
# الدوال التي قد تفشل (فك) ترجع ظرفا؛ ودوال التشفير ترجع
# النص مباشرة لأن المتصل يتحقق من الأنواع قبلها.

# --- تشفير قيمة واحدة إلى نص ---
صدر شفّر_قيمة
دالة شفّر_قيمة(قيمة_شق):
    نوع_شق = نوع(قيمة_شق)
    إذا نوع_شق == "لاشيء":
        ارجع "\_"
    وإلا إذا نوع_شق == "عدد":
        ارجع نص(قيمة_شق).استبدل("٫", ".")
    وإلا إذا نوع_شق == "منطقي":
        إذا قيمة_شق:
            ارجع "صحيح"
        وإلا:
            ارجع "خطأ"
    وإلا إذا نوع_شق == "نص":
        مشفّر_شق = ""
        لكل حرف_شق في قيمة_شق:
            إذا حرف_شق == "\\":
                مشفّر_شق = مشفّر_شق + "\\" + "\\"
            وإلا إذا حرف_شق == "|":
                مشفّر_شق = مشفّر_شق + "\\" + "|"
            وإلا إذا حرف_شق == "\n":
                مشفّر_شق = مشفّر_شق + "\\" + "ن"
            وإلا إذا حرف_شق == "\r":
                مشفّر_شق = مشفّر_شق + "\\" + "ر"
            وإلا:
                مشفّر_شق = مشفّر_شق + حرف_شق
        ارجع مشفّر_شق
    وإلا:
        ارجع ""

# --- فك حقل واحد مشفّر حسب نوعه المتوقع ---
# ترجع ظرفا: نجاحا "قيمة" هي القيمة، وفشلا "خطأ" يشرح التلف.
صدر فكّ_حقل
دالة فكّ_حقل(حقل_فح، نوع_فح):
    إذا حقل_فح == "\_":
        ارجع {"نجاح": صحيح, "قيمة": لاشيء, "خطأ": ""}
    نص_فح = ""
    عداد_فح = ٠
    طول_فح = طول(حقل_فح)
    بينما عداد_فح < طول_فح:
        حرف_فح = حقل_فح[عداد_فح]
        إذا حرف_فح == "\\":
            إذا عداد_فح + ١ >= طول_فح:
                ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "شرطة مائلة وحيدة في نهاية الحقل"}
            تال_فح = حقل_فح[عداد_فح + ١]
            إذا تال_فح == "\\":
                نص_فح = نص_فح + "\\"
            وإلا إذا تال_فح == "|":
                نص_فح = نص_فح + "|"
            وإلا إذا تال_فح == "ن":
                نص_فح = نص_فح + "\n"
            وإلا إذا تال_فح == "ر":
                نص_فح = نص_فح + "\r"
            وإلا:
                ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "هرب غير صالح في الحقل"}
            عداد_فح = عداد_فح + ٢
        وإلا:
            نص_فح = نص_فح + حرف_فح
            عداد_فح = عداد_فح + ١
    إذا نوع_فح == "نص":
        ارجع {"نجاح": صحيح, "قيمة": نص_فح, "خطأ": ""}
    وإلا إذا نوع_فح == "عدد":
        حاول:
            عدد_فح = عدد(نص_فح)
        ماعدا:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "قيمة عددية غير صالحة"}
        ارجع {"نجاح": صحيح, "قيمة": عدد_فح, "خطأ": ""}
    وإلا إذا نوع_فح == "منطقي":
        إذا نص_فح == "صحيح":
            ارجع {"نجاح": صحيح, "قيمة": صحيح, "خطأ": ""}
        وإلا إذا نص_فح == "خطأ":
            ارجع {"نجاح": صحيح, "قيمة": خطأ, "خطأ": ""}
        وإلا:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "قيمة منطقية غير صالحة"}
    وإلا:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "نوع غير معروف"}

# --- تقسيم سطر إلى حقول مع احترام الهرب ---
# لا نستعمل نص.قسم("|") هنا لأنه يقسم أيضا الأنابيب المهربة.
صدر قسم_حقول
دالة قسم_حقول(سطر_قح):
    حقول_قح = []
    حقل_قح = ""
    عداد_قح = ٠
    طول_قح = طول(سطر_قح)
    بينما عداد_قح < طول_قح:
        حرف_قح = سطر_قح[عداد_قح]
        إذا حرف_قح == "\\":
            حقل_قح = حقل_قح + "\\"
            إذا عداد_قح + ١ < طول_قح:
                حقل_قح = حقل_قح + سطر_قح[عداد_قح + ١]
                عداد_قح = عداد_قح + ٢
            وإلا:
                عداد_قح = عداد_قح + ١
        وإلا إذا حرف_قح == "|":
            حقول_قح.أضف(حقل_قح)
            حقل_قح = ""
            عداد_قح = عداد_قح + ١
        وإلا:
            حقل_قح = حقل_قح + حرف_قح
            عداد_قح = عداد_قح + ١
    حقول_قح.أضف(حقل_قح)
    ارجع حقول_قح

# --- تقسيم نص ملف إلى سطور ---
# يسقط السطر الفارغ الأخير (السطر الجديد الأخير) ويجرّد \r.
صدر قسم_سطور
دالة قسم_سطور(نص_قس):
    إذا نص_قس == "":
        سطور_قس = []
        ارجع سطور_قس
    سطور_قس = نص_قس.قسم("\n")
    إذا سطور_قس[طول(سطور_قس) - ١] == "":
        سطور_جديدة_قس = []
        عداد_قس = ٠
        بينما عداد_قس < طول(سطور_قس) - ١:
            سطور_جديدة_قس.أضف(سطور_قس[عداد_قس])
            عداد_قس = عداد_قس + ١
        سطور_قس = سطور_جديدة_قس
    نظيفة_قس = []
    لكل سطر_قس في سطور_قس:
        إذا طول(سطر_قس) > ٠:
            إذا سطر_قس[طول(سطر_قس) - ١] == "\r":
                مقصوص_قس = ""
                عداد_قس = ٠
                بينما عداد_قس < طول(سطر_قس) - ١:
                    مقصوص_قس = مقصوص_قس + سطر_قس[عداد_قس]
                    عداد_قس = عداد_قس + ١
                نظيفة_قس.أضف(مقصوص_قس)
            وإلا:
                نظيفة_قس.أضف(سطر_قس)
        وإلا:
            نظيفة_قس.أضف(سطر_قس)
    ارجع نظيفة_قس

# --- تشفير صف كامل إلى سطر: _معرف|حقل|حقل|... ---
صدر شفّر_صف
دالة شفّر_صف(صف_شص، أعمدة_شص):
    سطر_شص = نص(صف_شص["_معرف"])
    لكل عمود_شص في أعمدة_شص:
        سطر_شص = سطر_شص + "|" + شفّر_قيمة(صف_شص[عمود_شص])
    ارجع سطر_شص

# --- فك سطر صف إلى ظرف {"معرف": n, "صف": {...}} ---
صدر فكّ_صف
دالة فكّ_صف(سطر_فص، أعمدة_فص، أنواع_فص):
    حقول_فص = قسم_حقول(سطر_فص)
    إذا طول(حقول_فص) != طول(أعمدة_فص) + ١:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "عدد الحقول لا يطابق المخطط"}
    ظرف_فص = فكّ_حقل(حقول_فص[٠], "عدد")
    إذا ليس ظرف_فص["نجاح"]:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "معرف الصف غير صالح"}
    معرف_فص = ظرف_فص["قيمة"]
    إذا نص(معرف_فص).يحتوي("٫") أو نص(معرف_فص).يحتوي("."):
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "معرف الصف ليس عددا صحيحا"}
    إذا معرف_فص < ١:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "معرف الصف أقل من ١"}
    صف_فص = {"_معرف": معرف_فص}
    عداد_فص = ٠
    بينما عداد_فص < طول(أعمدة_فص):
        عمود_فص = أعمدة_فص[عداد_فص]
        ظرف_فص = فكّ_حقل(حقول_فص[عداد_فص + ١], أنواع_فص[عمود_فص])
        إذا ليس ظرف_فص["نجاح"]:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "حقل تالف في العمود " + عمود_فص}
        صف_فص[عمود_فص] = ظرف_فص["قيمة"]
        عداد_فص = عداد_فص + ١
    ارجع {"نجاح": صحيح, "قيمة": {"معرف": معرف_فص, "صف": صف_فص}, "خطأ": ""}

# --- تشفير سطر المخطط: اسم|عمود:نوع|عمود:نوع ---
صدر شفّر_مخطط
دالة شفّر_مخطط(اسم_شم، أعمدة_شم، أنواع_شم):
    سطر_شم = اسم_شم
    لكل عمود_شم في أعمدة_شم:
        سطر_شم = سطر_شم + "|" + عمود_شم + ":" + أنواع_شم[عمود_شم]
    ارجع سطر_شم

# --- فك سطر المخطط إلى ظرف {"اسم": ..., "أعمدة": [...], "أنواع": {...}} ---
صدر فكّ_مخطط
دالة فكّ_مخطط(سطر_فم):
    أجزاء_فم = سطر_فم.قسم("|")
    إذا طول(أجزاء_فم) < ٢:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "سطر المخطط بلا أعمدة"}
    اسم_فم = أجزاء_فم[٠]
    أعمدة_فم = []
    أنواع_فم = {}
    عداد_فم = ١
    بينما عداد_فم < طول(أجزاء_فم):
        زوج_فم = أجزاء_فم[عداد_فم].قسم(":")
        إذا طول(زوج_فم) != ٢:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "عمود بلا نوع في المخطط"}
        أعمدة_فم.أضف(زوج_فم[٠])
        أنواع_فم[زوج_فم[٠]] = زوج_فم[١]
        عداد_فم = عداد_فم + ١
    ارجع {"نجاح": صحيح, "قيمة": {"اسم": اسم_فم, "أعمدة": أعمدة_فم, "أنواع": أنواع_فم}, "خطأ": ""}
