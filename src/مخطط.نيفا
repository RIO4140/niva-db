# وحدة مخطط — صلاحية الأسماء والمخططات والصفوف
# الأنواع في v0.1: عدد، نص، منطقي. وقيمة لاشيء مسموحة في أي عمود.

# --- هل الاسم صالح لقاعدة أو جدول أو عمود؟ ---
صدر صالح_اسم
دالة صالح_اسم(اسم_صا):
    إذا نوع(اسم_صا) != "نص":
        ارجع خطأ
    إذا طول(اسم_صا) == ٠:
        ارجع خطأ
    إذا اسم_صا[٠] == "_":
        ارجع خطأ
    لكل حرف_صا في اسم_صا:
        إذا حرف_صا في "|:\\/\n":
            ارجع خطأ
        إذا حرف_صا == "\r":
            ارجع خطأ
    ارجع صحيح

# --- هل النوع من أنواع v0.1؟ ---
صدر صالح_نوع
دالة صالح_نوع(نوع_صن):
    إذا نوع_صن == "عدد":
        ارجع صحيح
    إذا نوع_صن == "نص":
        ارجع صحيح
    إذا نوع_صن == "منطقي":
        ارجع صحيح
    ارجع خطأ

# --- التحقق من مخطط: قائمة أزواج [اسم، نوع] ---
# ترجع ظرفا: نجاحا "قيمة" هي {"أعمدة": [...], "أنواع": {...}}.
صدر تحقق_مخطط
دالة تحقق_مخطط(مخطط_تحم):
    إذا نوع(مخطط_تحم) != "قائمة":
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "المخطط يجب أن يكون قائمة أزواج"}
    إذا طول(مخطط_تحم) == ٠:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "المخطط بلا أعمدة"}
    أعمدة_تحم = []
    أنواع_تحم = {}
    لكل زوج_تحم في مخطط_تحم:
        إذا نوع(زوج_تحم) != "قائمة":
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "كل عمود في المخطط زوج [اسم، نوع]"}
        إذا طول(زوج_تحم) != ٢:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "كل عمود في المخطط زوج [اسم، نوع]"}
        اسم_تحم = زوج_تحم[٠]
        نوع_تحم = زوج_تحم[١]
        إذا ليس صالح_اسم(اسم_تحم):
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "اسم عمود غير صالح"}
        إذا ليس صالح_نوع(نوع_تحم):
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "نوع غير صالح في العمود " + نص(اسم_تحم)}
        إذا اسم_تحم في أنواع_تحم:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "عمود مكرر في المخطط: " + نص(اسم_تحم)}
        أعمدة_تحم.أضف(اسم_تحم)
        أنواع_تحم[اسم_تحم] = نوع_تحم
    ارجع {"نجاح": صحيح, "قيمة": {"أعمدة": أعمدة_تحم, "أنواع": أنواع_تحم}, "خطأ": ""}

# --- التحقق من صف مدخَل وتطبيعه ---
# الأعمدة الناقصة تأخذ لاشيء؛ والأعمدة الغريبة والنوع الخاطئ خطأ.
# ترجع ظرفا: نجاحا "قيمة" هي الصف المطبَّع (بلا _معرف).
صدر تحقق_صف
دالة تحقق_صف(صف_تحص، أعمدة_تحص، أنواع_تحص):
    إذا نوع(صف_تحص) != "قاموس":
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "الصف يجب أن يكون قاموسا"}
    معروف_تحص = ٠
    لكل عمود_تحص في أعمدة_تحص:
        إذا عمود_تحص في صف_تحص:
            معروف_تحص = معروف_تحص + ١
    إذا طول(صف_تحص) != معروف_تحص:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "الصف فيه عمود غير موجود في المخطط"}
    صف_جديد_تحص = {}
    لكل عمود_تحص في أعمدة_تحص:
        إذا عمود_تحص في صف_تحص:
            قيمة_تحص = صف_تحص[عمود_تحص]
            نوع_تحص = أنواع_تحص[عمود_تحص]
            إذا نوع(قيمة_تحص) == "لاشيء":
                صف_جديد_تحص[عمود_تحص] = لاشيء
            وإلا إذا نوع(قيمة_تحص) == نوع_تحص:
                صف_جديد_تحص[عمود_تحص] = قيمة_تحص
            وإلا:
                ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "نوع خاطئ في العمود " + عمود_تحص}
        وإلا:
            صف_جديد_تحص[عمود_تحص] = لاشيء
    ارجع {"نجاح": صحيح, "قيمة": صف_جديد_تحص, "خطأ": ""}
