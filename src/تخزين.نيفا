# وحدة تخزين — كتابة ذرية وقراءة آمنة ومجلدات وسرد
# الكتابة الذرية: كل الملفات تُكتب مؤقتا أولا ثم تُنقَل؛
# ففشل أي كتابة مؤقتة يبقي الملفات القديمة كلها سليمة.

# --- هل المسار موجود؟ ---
صدر يوجد
دالة يوجد(مسار_يوج):
    تفاصيل_يوج = تفاصيل_المسار(مسار_يوج)
    ارجع تفاصيل_يوج["نوع"] != "غير موجود"

# --- هل يبدأ النص بالبادئة؟ (بلا دالة مدمجة) ---
صدر يبدأ_ب
دالة يبدأ_ب(نص_يبد، بادئة_يبد):
    إذا طول(نص_يبد) < طول(بادئة_يبد):
        ارجع خطأ
    عداد_يبد = ٠
    بينما عداد_يبد < طول(بادئة_يبد):
        إذا نص_يبد[عداد_يبد] != بادئة_يبد[عداد_يبد]:
            ارجع خطأ
        عداد_يبد = عداد_يبد + ١
    ارجع صحيح

# --- هل ينتهي النص باللاحقة؟ (بلا دالة مدمجة) ---
صدر ينتهي_ب
دالة ينتهي_ب(نص_ينت، لاحقة_ينت):
    إذا طول(نص_ينت) < طول(لاحقة_ينت):
        ارجع خطأ
    بداية_ينت = طول(نص_ينت) - طول(لاحقة_ينت)
    عداد_ينت = ٠
    بينما عداد_ينت < طول(لاحقة_ينت):
        إذا نص_ينت[بداية_ينت + عداد_ينت] != لاحقة_ينت[عداد_ينت]:
            ارجع خطأ
        عداد_ينت = عداد_ينت + ١
    ارجع صحيح

# --- إنشاء مجلد بكل آبائه (مستوى مستوى) ---
# ترجع ظرفا: نجاحا "قيمة" هي المسار.
صدر أنشئ_مجلدات
دالة أنشئ_مجلدات(مسار_أنم):
    أجزاء_أنم = مسار_أنم.قسم("/")
    متراكم_أنم = ""
    لكل جزء_أنم في أجزاء_أنم:
        إذا جزء_أنم == "":
            تابع
        إذا متراكم_أنم == "":
            متراكم_أنم = جزء_أنم
        وإلا:
            متراكم_أنم = متراكم_أنم + "/" + جزء_أنم
        إذا ليس يوجد(متراكم_أنم):
            حاول:
                أنشئ_مجلد(متراكم_أنم)
            ماعدا:
                ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر إنشاء المجلد " + متراكم_أنم}
    ارجع {"نجاح": صحيح, "قيمة": مسار_أنم, "خطأ": ""}

# --- قراءة ملف بأمان: ترجع ظرفا بالمكتوب أو بالخطأ ---
صدر اقرأ_آمن
دالة اقرأ_آمن(مسار_قآ):
    حاول:
        محتوى_قآ = اقرأ_ملف(مسار_قآ)
    ماعدا:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر قراءة الملف " + مسار_قآ}
    ارجع {"نجاح": صحيح, "قيمة": محتوى_قآ, "خطأ": ""}

# --- حذف ملف بصمت (فشل الحذف ليس خطأ هنا) ---
دالة احذف_بصمت(مسار_حذب):
    حاول:
        احذف_ملف(مسار_حذب)
    ماعدا:
        ارجع لاشيء
    ارجع لاشيء

# --- كتابة ذرية لقائمة [مسار، محتوى] ---
# المرحلة ١: كتابة كل الملفات المؤقتة. المرحلة ٢: نقلها كلها.
صدر اكتب_ملفات_ذرية
دالة اكتب_ملفات_ذرية(ملفات_اكم):
    مؤقتات_اكم = []
    لكل زوج_اكم في ملفات_اكم:
        مسار_اكم = زوج_اكم[٠]
        محتوى_اكم = زوج_اكم[١]
        مؤقت_اكم = مسار_اكم + ".مؤقت"
        حاول:
            اكتب_ملف(مؤقت_اكم, محتوى_اكم)
        ماعدا:
            لكل مكتوب_اكم في مؤقتات_اكم:
                احذف_بصمت(مكتوب_اكم)
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر كتابة الملف " + مسار_اكم}
        مؤقتات_اكم.أضف(مؤقت_اكم)
    عداد_اكم = ٠
    بينما عداد_اكم < طول(ملفات_اكم):
        مسار_اكم = ملفات_اكم[عداد_اكم][٠]
        مؤقت_اكم = مؤقتات_اكم[عداد_اكم]
        حاول:
            انقل(مؤقت_اكم, مسار_اكم)
        ماعدا:
            ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر نقل الملف " + مسار_اكم}
        عداد_اكم = عداد_اكم + ١
    ارجع {"نجاح": صحيح, "قيمة": طول(ملفات_اكم), "خطأ": ""}

# --- سرد أسماء مجلد مع استعادة مجلد الجلسة ---
# ترجع ظرفا: نجاحا "قيمة" هي قائمة الأسماء.
صدر سرد
دالة سرد(مجلد_سرد):
    حالي_سرد = المجلد_الحالي()
    أسماء_سرد = لاشيء
    حاول:
        انتقل(مجلد_سرد)
        أسماء_سرد = اعرض_الملفات()
    ماعدا:
        أسماء_سرد = لاشيء
    أخيرا:
        انتقل(حالي_سرد)
    إذا أسماء_سرد == لاشيء:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر سرد المجلد " + مجلد_سرد}
    ارجع {"نجاح": صحيح, "قيمة": أسماء_سرد, "خطأ": ""}

# --- حذف شجرة مجلد كاملة (ملفات ثم مجلدات فارغة) ---
# غياب المسار ليس خطأ. ترجع ظرفا.
صدر احذف_شجرة
دالة احذف_شجرة(مسار_حشج):
    إذا ليس يوجد(مسار_حشج):
        ارجع {"نجاح": صحيح, "قيمة": لاشيء, "خطأ": ""}
    ظرف_حشج = سرد(مسار_حشج)
    إذا ليس ظرف_حشج["نجاح"]:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر سرد المجلد " + مسار_حشج}
    لكل اسم_حشج في ظرف_حشج["قيمة"]:
        فرعي_حشج = مسار_حشج + "/" + اسم_حشج
        تفاصيل_حشج = تفاصيل_المسار(فرعي_حشج)
        إذا تفاصيل_حشج["نوع"] == "مجلد":
            ظرف_حشج = احذف_شجرة(فرعي_حشج)
            إذا ليس ظرف_حشج["نجاح"]:
                ارجع ظرف_حشج
        وإلا:
            حاول:
                احذف_ملف(فرعي_حشج)
            ماعدا:
                ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر حذف الملف " + فرعي_حشج}
    حاول:
        احذف_مجلد(مسار_حشج)
    ماعدا:
        ارجع {"نجاح": خطأ, "قيمة": لاشيء, "خطأ": "تعذر حذف المجلد " + مسار_حشج}
    ارجع {"نجاح": صحيح, "قيمة": لاشيء, "خطأ": ""}
