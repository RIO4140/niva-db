# وحدة قاعدة — الواجهة العامة لـ NivaDB Core v0.1
# كل دالة عامة ترجع ظرفا: {"نجاح": منطقي, "قيمة": أي, "خطأ": نص}.
# كل دالة تعدّل جدولا ترجع الجدول المحدَّث في "قيمة" والمتصل يعيد الربط
# (معاملات الدوال نُسخ في اللغة — انظر docs/فجوات-وجدتها-أثناء-البناء.md).

استورد نتيجة
استورد ترميز
استورد مخطط
استورد تخزين
استورد فهرس
استورد رياضيات

# --- داخلي: نسخة من صف (بأعمدة الجدول + _معرف) ---
دالة نسخة_صف(صف_نسص، أعمدة_نسص):
    نسخة_نسص = {"_معرف": صف_نسص["_معرف"]}
    لكل عمود_نسص في أعمدة_نسص:
        نسخة_نسص[عمود_نسص] = صف_نسص[عمود_نسص]
    ارجع نسخة_نسص

# --- داخلي: بحث ثنائي بـ _معرف في صفوف مرتبة ---
# ترجع فهرس الصف أو -١.
دالة بحث_ثنائي(صفوف_بثن، معرف_بثن):
    أول_بثن = ٠
    آخر_بثن = طول(صفوف_بثن) - ١
    بينما أول_بثن <= آخر_بثن:
        وسط_بثن = رياضيات.أرضية((أول_بثن + آخر_بثن) / ٢)
        معرف_وسط_بثن = صفوف_بثن[وسط_بثن]["_معرف"]
        إذا معرف_وسط_بثن == معرف_بثن:
            ارجع وسط_بثن
        وإلا إذا معرف_وسط_بثن < معرف_بثن:
            أول_بثن = وسط_بثن + ١
        وإلا:
            آخر_بثن = وسط_بثن - ١
    ارجع -١

# --- داخلي: رقم شظية من اسمها (شظية-١.جدول ← ١) أو -١ ---
دالة رقم_شظية(اسم_رقش):
    إذا ليس تخزين.يبدأ_ب(اسم_رقش, "شظية-"):
        ارجع -١
    إذا ليس تخزين.ينتهي_ب(اسم_رقش, ".جدول"):
        ارجع -١
    وسط_رقش = ""
    عداد_رقش = ٥
    بينما عداد_رقش < طول(اسم_رقش) - ٥:
        وسط_رقش = وسط_رقش + اسم_رقش[عداد_رقش]
        عداد_رقش = عداد_رقش + ١
    حاول:
        رقم_رقش = عدد(وسط_رقش)
    ماعدا:
        ارجع -١
    إذا نص(رقم_رقش).يحتوي("٫") أو نص(رقم_رقش).يحتوي("."):
        ارجع -١
    ارجع رقم_رقش

# --- داخلي: فرز إدخال لقائمة أزواج [رقم، اسم] حسب الرقم ---
دالة فرز_أزواج(أزواج_فرز):
    عداد_فرز = ١
    بينما عداد_فرز < طول(أزواج_فرز):
        زوج_فرز = أزواج_فرز[عداد_فرز]
        سابق_فرز = عداد_فرز - ١
        موضع_فرز = عداد_فرز
        بينما سابق_فرز >= ٠:
            إذا أزواج_فرز[سابق_فرز][٠] > زوج_فرز[٠]:
                أزواج_فرز[سابق_فرز + ١] = أزواج_فرز[سابق_فرز]
                موضع_فرز = سابق_فرز
                سابق_فرز = سابق_فرز - ١
            وإلا:
                سابق_فرز = -١
        أزواج_فرز[موضع_فرز] = زوج_فرز
        عداد_فرز = عداد_فرز + ١
    ارجع أزواج_فرز

# --- إنشاء قاعدة بيانات (مجلد) ---
صدر أنشئ_قاعدة
دالة أنشئ_قاعدة(اسم_أنقق):
    إذا ليس مخطط.صالح_اسم(اسم_أنقق):
        ارجع نتيجة.فاشل("اسم قاعدة غير صالح")
    إذا تخزين.يوجد(اسم_أنقق):
        ارجع نتيجة.فاشل("قاعدة موجودة بالفعل: " + اسم_أنقق)
    ظرف_أنقق = تخزين.أنشئ_مجلدات(اسم_أنقق)
    إذا ليس ظرف_أنقق["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_أنقق["خطأ"])
    ارجع نتيجة.ناجح(اسم_أنقق)

# --- حذف قاعدة بيانات كاملة (غيابها ليس خطأ) ---
صدر احذف_قاعدة
دالة احذف_قاعدة(اسم_احق):
    ظرف_احق = تخزين.احذف_شجرة(اسم_احق)
    إذا ليس ظرف_احق["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_احق["خطأ"])
    ارجع نتيجة.ناجح(لاشيء)

# --- إنشاء جدول جديد في قاعدة ---
صدر أنشئ_جدول
دالة أنشئ_جدول(قاعدة_أنج، اسم_أنج، مخطط_أنج):
    إذا ليس تخزين.يوجد(قاعدة_أنج):
        ارجع نتيجة.فاشل("القاعدة غير موجودة: " + قاعدة_أنج)
    إذا ليس مخطط.صالح_اسم(اسم_أنج):
        ارجع نتيجة.فاشل("اسم جدول غير صالح")
    ظرف_أنج = مخطط.تحقق_مخطط(مخطط_أنج)
    إذا ليس ظرف_أنج["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_أنج["خطأ"])
    أعمدة_أنج = ظرف_أنج["قيمة"]["أعمدة"]
    أنواع_أنج = ظرف_أنج["قيمة"]["أنواع"]
    مجلد_أنج = قاعدة_أنج + "/" + اسم_أنج
    إذا تخزين.يوجد(مجلد_أنج):
        ارجع نتيجة.فاشل("جدول موجود بالفعل: " + اسم_أنج)
    ظرف_أنج = تخزين.أنشئ_مجلدات(مجلد_أنج)
    إذا ليس ظرف_أنج["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_أنج["خطأ"])
    سطر_أنج = ترميز.شفّر_مخطط(اسم_أنج, أعمدة_أنج, أنواع_أنج)
    ملفات_أنج = []
    ملفات_أنج.أضف([مجلد_أنج + "/مخطط.جدول", سطر_أنج + "\n"])
    ظرف_أنج = تخزين.اكتب_ملفات_ذرية(ملفات_أنج)
    إذا ليس ظرف_أنج["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_أنج["خطأ"])
    صفوف_أنج = []
    تقرير_أنج = []
    جدول_أنج = {"مسار": مجلد_أنج, "اسم": اسم_أنج, "أعمدة": أعمدة_أنج, "أنواع": أنواع_أنج, "صفوف": صفوف_أنج, "التالي": ١, "فهارس": {}, "أعمدة_مفهرسة": [], "متسخ": خطأ, "تقرير": تقرير_أنج}
    ارجع نتيجة.ناجح(جدول_أنج)

# --- فتح جدول موجود من القرص ---
صدر افتح_جدول
دالة افتح_جدول(قاعدة_افت، اسم_افت):
    مجلد_افت = قاعدة_افت + "/" + اسم_افت
    إذا ليس تخزين.يوجد(مجلد_افت):
        ارجع نتيجة.فاشل("الجدول غير موجود: " + اسم_افت)
    ظرف_افت = تخزين.اقرأ_آمن(مجلد_افت + "/مخطط.جدول")
    إذا ليس ظرف_افت["نجاح"]:
        ارجع نتيجة.فاشل("تعذر قراءة مخطط الجدول " + اسم_افت)
    سطور_افت = ترميز.قسم_سطور(ظرف_افت["قيمة"])
    إذا طول(سطور_افت) == ٠:
        ارجع نتيجة.فاشل("ملف المخطط فارغ في الجدول " + اسم_افت)
    ظرف_افت = ترميز.فكّ_مخطط(سطور_افت[٠])
    إذا ليس ظرف_افت["نجاح"]:
        ارجع نتيجة.فاشل("مخطط الجدول تالف: " + ظرف_افت["خطأ"])
    مخطط_افت = ظرف_افت["قيمة"]
    إذا مخطط_افت["اسم"] != اسم_افت:
        ارجع نتيجة.فاشل("اسم المخطط لا يطابق اسم الجدول")
    أعمدة_افت = مخطط_افت["أعمدة"]
    أنواع_افت = مخطط_افت["أنواع"]
    مخطط_أزواج_افت = []
    لكل عمود_افت في أعمدة_افت:
        زوج_افت = []
        زوج_افت.أضف(عمود_افت)
        زوج_افت.أضف(أنواع_افت[عمود_افت])
        مخطط_أزواج_افت.أضف(زوج_افت)
    ظرف_افت = مخطط.تحقق_مخطط(مخطط_أزواج_افت)
    إذا ليس ظرف_افت["نجاح"]:
        ارجع نتيجة.فاشل("مخطط الجدول غير صالح")
    ظرف_افت = تخزين.سرد(مجلد_افت)
    إذا ليس ظرف_افت["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_افت["خطأ"])
    تقرير_افت = []
    شظايا_افت = []
    أعمدة_فهرس_افت = []
    لكل اسم_ملف_افت في ظرف_افت["قيمة"]:
        رقم_افت = رقم_شظية(اسم_ملف_افت)
        إذا رقم_افت >= ١:
            زوج_افت = []
            زوج_افت.أضف(رقم_افت)
            زوج_افت.أضف(اسم_ملف_افت)
            شظايا_افت.أضف(زوج_افت)
        وإلا إذا تخزين.يبدأ_ب(اسم_ملف_افت, "فهرس-"):
            إذا تخزين.ينتهي_ب(اسم_ملف_افت, ".جدول"):
                عمود_افت = ""
                عداد_افت = ٥
                بينما عداد_افت < طول(اسم_ملف_افت) - ٥:
                    عمود_افت = عمود_افت + اسم_ملف_افت[عداد_افت]
                    عداد_افت = عداد_افت + ١
                أعمدة_فهرس_افت.أضف(عمود_افت)
    شظايا_افت = فرز_أزواج(شظايا_افت)
    صفوف_افت = []
    أكبر_افت = ٠
    سابق_افت = ٠
    لكل زوج_افت في شظايا_افت:
        ظرف_افت = تخزين.اقرأ_آمن(مجلد_افت + "/" + زوج_افت[١])
        إذا ليس ظرف_افت["نجاح"]:
            تقرير_افت.أضف("شظية غير مقروءة: " + زوج_افت[١])
            تابع
        سطور_افت = ترميز.قسم_سطور(ظرف_افت["قيمة"])
        لكل سطر_افت في سطور_افت:
            ظرف_افت = ترميز.فكّ_صف(سطر_افت, أعمدة_افت, أنواع_افت)
            إذا ليس ظرف_افت["نجاح"]:
                تقرير_افت.أضف("سطر تالف في " + زوج_افت[١] + ": " + ظرف_افت["خطأ"])
                تابع
            صف_افت = ظرف_افت["قيمة"]["صف"]
            معرف_افت = ظرف_افت["قيمة"]["معرف"]
            إذا معرف_افت <= سابق_افت:
                تقرير_افت.أضف("ترتيب المعرفات غير متصاعد في " + زوج_افت[١])
            سابق_افت = معرف_افت
            إذا معرف_افت > أكبر_افت:
                أكبر_افت = معرف_افت
            صفوف_افت.أضف(صف_افت)
    فهارس_افت = {}
    مفهرسة_افت = []
    لكل عمود_افت في أعمدة_فهرس_افت:
        إذا عمود_افت في أنواع_افت:
            ظرف_افت = تخزين.اقرأ_آمن(مجلد_افت + "/فهرس-" + عمود_افت + ".جدول")
            إذا ظرف_افت["نجاح"]:
                سطور_افت = ترميز.قسم_سطور(ظرف_افت["قيمة"])
                ظرف_افت = فهرس.فكّ(سطور_افت)
                إذا ليس ظرف_افت["نجاح"]:
                    تقرير_افت.أضف("ملف فهرس تالف للعمود " + عمود_افت + ": " + ظرف_افت["خطأ"])
            مفهرسة_افت.أضف(عمود_افت)
    جدول_افت = {"مسار": مجلد_افت, "اسم": اسم_افت, "أعمدة": أعمدة_افت, "أنواع": أنواع_افت, "صفوف": صفوف_افت, "التالي": أكبر_افت + ١, "فهارس": فهارس_افت, "أعمدة_مفهرسة": مفهرسة_افت, "متسخ": خطأ, "تقرير": تقرير_افت}
    لكل عمود_افت في مفهرسة_افت:
        فهرس_افت = فهرس.جديد()
        لكل صف_افت في صفوف_افت:
            إذا "_محذوف" في صف_افت:
                تابع
            مفتاح_افت = ترميز.شفّر_قيمة(صف_افت[عمود_افت])
            فهرس_افت = فهرس.أضف(فهرس_افت, مفتاح_افت, صف_افت["_معرف"])
        فهارس_افت[عمود_افت] = فهرس_افت
    جدول_افت["فهارس"] = فهارس_افت
    ارجع نتيجة.ناجح(جدول_افت)

# --- إدخال صف جديد ---
صدر أدخل
دالة أدخل(جدول_أدخ، صف_أدخ):
    ظرف_أدخ = مخطط.تحقق_صف(صف_أدخ, جدول_أدخ["أعمدة"], جدول_أدخ["أنواع"])
    إذا ليس ظرف_أدخ["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_أدخ["خطأ"])
    صف_جديد_أدخ = ظرف_أدخ["قيمة"]
    معرف_أدخ = جدول_أدخ["التالي"]
    صف_جديد_أدخ["_معرف"] = معرف_أدخ
    صفوف_أدخ = جدول_أدخ["صفوف"]
    صفوف_أدخ.أضف(صف_جديد_أدخ)
    جدول_أدخ["صفوف"] = صفوف_أدخ
    جدول_أدخ["التالي"] = معرف_أدخ + ١
    فهارس_أدخ = جدول_أدخ["فهارس"]
    لكل عمود_أدخ في جدول_أدخ["أعمدة_مفهرسة"]:
        مفتاح_أدخ = ترميز.شفّر_قيمة(صف_جديد_أدخ[عمود_أدخ])
        فهرس_أدخ = فهارس_أدخ[عمود_أدخ]
        فهرس_أدخ = فهرس.أضف(فهرس_أدخ, مفتاح_أدخ, معرف_أدخ)
        فهارس_أدخ[عمود_أدخ] = فهرس_أدخ
    جدول_أدخ["فهارس"] = فهارس_أدخ
    جدول_أدخ["متسخ"] = صحيح
    ارجع نتيجة.ناجح({"جدول": جدول_أدخ, "معرف": معرف_أدخ})

# --- اختيار صفوف بشرط (دالة نيفا تستلم نسخة الصف) ---
صدر اختر
دالة اختر(جدول_اخت، شرط_اخت):
    نتائج_اخت = []
    لكل صف_اخت في جدول_اخت["صفوف"]:
        إذا "_محذوف" في صف_اخت:
            تابع
        نسخة_اخت = نسخة_صف(صف_اخت, جدول_اخت["أعمدة"])
        حاول:
            يطابق_اخت = شرط_اخت(نسخة_اخت)
        ماعدا:
            ارجع نتيجة.فاشل("الشرط أخطأ أثناء الاستعلام")
        إذا يطابق_اخت:
            نتائج_اخت.أضف(نسخة_اخت)
    ارجع نتيجة.ناجح(نتائج_اخت)

# --- تحديث صفوف مطابقة بتغييرات ---
صدر حدّث
دالة حدّث(جدول_حدّ، شرط_حدّ، تغييرات_حدّ):
    إذا نوع(تغييرات_حدّ) != "قاموس":
        ارجع نتيجة.فاشل("التغييرات يجب أن تكون قاموسا")
    معروف_حدّ = ٠
    لكل عمود_حدّ في جدول_حدّ["أعمدة"]:
        إذا عمود_حدّ في تغييرات_حدّ:
            معروف_حدّ = معروف_حدّ + ١
            قيمة_حدّ = تغييرات_حدّ[عمود_حدّ]
            نوع_حدّ = جدول_حدّ["أنواع"][عمود_حدّ]
            إذا نوع(قيمة_حدّ) != "لاشيء":
                إذا نوع(قيمة_حدّ) != نوع_حدّ:
                    ارجع نتيجة.فاشل("نوع خاطئ في العمود " + عمود_حدّ)
    إذا طول(تغييرات_حدّ) != معروف_حدّ:
        ارجع نتيجة.فاشل("التغييرات فيها عمود غير موجود في المخطط")
    إذا طول(تغييرات_حدّ) == ٠:
        ارجع نتيجة.فاشل("التغييرات فارغة")
    عدد_حدّ = ٠
    صفوف_حدّ = جدول_حدّ["صفوف"]
    عداد_حدّ = ٠
    بينما عداد_حدّ < طول(صفوف_حدّ):
        صف_حدّ = صفوف_حدّ[عداد_حدّ]
        إذا "_محذوف" في صف_حدّ:
            عداد_حدّ = عداد_حدّ + ١
            تابع
        نسخة_حدّ = نسخة_صف(صف_حدّ, جدول_حدّ["أعمدة"])
        حاول:
            يطابق_حدّ = شرط_حدّ(نسخة_حدّ)
        ماعدا:
            ارجع نتيجة.فاشل("الشرط أخطأ أثناء الاستعلام")
        إذا ليس يطابق_حدّ:
            عداد_حدّ = عداد_حدّ + ١
            تابع
        فهارس_حدّ = جدول_حدّ["فهارس"]
        لكل عمود_حدّ في جدول_حدّ["أعمدة_مفهرسة"]:
            إذا عمود_حدّ في تغييرات_حدّ:
                مفتاح_قديم_حدّ = ترميز.شفّر_قيمة(صف_حدّ[عمود_حدّ])
                مفتاح_جديد_حدّ = ترميز.شفّر_قيمة(تغييرات_حدّ[عمود_حدّ])
                فهرس_حدّ = فهارس_حدّ[عمود_حدّ]
                فهرس_حدّ = فهرس.اسحب(فهرس_حدّ, مفتاح_قديم_حدّ, صف_حدّ["_معرف"])
                فهرس_حدّ = فهرس.أضف(فهرس_حدّ, مفتاح_جديد_حدّ, صف_حدّ["_معرف"])
                فهارس_حدّ[عمود_حدّ] = فهرس_حدّ
        جدول_حدّ["فهارس"] = فهارس_حدّ
        لكل عمود_حدّ في جدول_حدّ["أعمدة"]:
            إذا عمود_حدّ في تغييرات_حدّ:
                صف_حدّ[عمود_حدّ] = تغييرات_حدّ[عمود_حدّ]
        صفوف_حدّ[عداد_حدّ] = صف_حدّ
        عدد_حدّ = عدد_حدّ + ١
        عداد_حدّ = عداد_حدّ + ١
    جدول_حدّ["صفوف"] = صفوف_حدّ
    إذا عدد_حدّ > ٠:
        جدول_حدّ["متسخ"] = صحيح
    ارجع نتيجة.ناجح({"جدول": جدول_حدّ, "عدد": عدد_حدّ})

# --- حذف منطقي لصفوف مطابقة ---
صدر احذف
دالة احذف(جدول_احذ، شرط_احذ):
    عدد_احذ = ٠
    صفوف_احذ = جدول_احذ["صفوف"]
    عداد_احذ = ٠
    بينما عداد_احذ < طول(صفوف_احذ):
        صف_احذ = صفوف_احذ[عداد_احذ]
        إذا "_محذوف" في صف_احذ:
            عداد_احذ = عداد_احذ + ١
            تابع
        نسخة_احذ = نسخة_صف(صف_احذ, جدول_احذ["أعمدة"])
        حاول:
            يطابق_احذ = شرط_احذ(نسخة_احذ)
        ماعدا:
            ارجع نتيجة.فاشل("الشرط أخطأ أثناء الاستعلام")
        إذا ليس يطابق_احذ:
            عداد_احذ = عداد_احذ + ١
            تابع
        فهارس_احذ = جدول_احذ["فهارس"]
        لكل عمود_احذ في جدول_احذ["أعمدة_مفهرسة"]:
            مفتاح_احذ = ترميز.شفّر_قيمة(صف_احذ[عمود_احذ])
            فهرس_احذ = فهارس_احذ[عمود_احذ]
            فهرس_احذ = فهرس.اسحب(فهرس_احذ, مفتاح_احذ, صف_احذ["_معرف"])
            فهارس_احذ[عمود_احذ] = فهرس_احذ
        جدول_احذ["فهارس"] = فهارس_احذ
        صف_احذ["_محذوف"] = صحيح
        صفوف_احذ[عداد_احذ] = صف_احذ
        عدد_احذ = عدد_احذ + ١
        عداد_احذ = عداد_احذ + ١
    جدول_احذ["صفوف"] = صفوف_احذ
    إذا عدد_احذ > ٠:
        جدول_احذ["متسخ"] = صحيح
    ارجع نتيجة.ناجح({"جدول": جدول_احذ, "عدد": عدد_احذ})

# --- إنشاء فهرس على عمود ---
صدر أنشئ_فهرس
دالة أنشئ_فهرس(جدول_أنف، عمود_أنف):
    موجود_أنف = خطأ
    إذا عمود_أنف في جدول_أنف["أنواع"]:
        موجود_أنف = صحيح
    إذا ليس موجود_أنف:
        ارجع نتيجة.فاشل("العمود غير موجود في المخطط: " + عمود_أنف)
    لكل موجود_أنف في جدول_أنف["أعمدة_مفهرسة"]:
        إذا موجود_أنف == عمود_أنف:
            ارجع نتيجة.فاشل("الفهرس موجود بالفعل على العمود " + عمود_أنف)
    فهرس_أنف = فهرس.جديد()
    لكل صف_أنف في جدول_أنف["صفوف"]:
        إذا "_محذوف" في صف_أنف:
            تابع
        مفتاح_أنف = ترميز.شفّر_قيمة(صف_أنف[عمود_أنف])
        فهرس_أنف = فهرس.أضف(فهرس_أنف, مفتاح_أنف, صف_أنف["_معرف"])
    فهارس_أنف = جدول_أنف["فهارس"]
    فهارس_أنف[عمود_أنف] = فهرس_أنف
    جدول_أنف["فهارس"] = فهارس_أنف
    مفهرسة_أنف = جدول_أنف["أعمدة_مفهرسة"]
    مفهرسة_أنف.أضف(عمود_أنف)
    جدول_أنف["أعمدة_مفهرسة"] = مفهرسة_أنف
    جدول_أنف["متسخ"] = صحيح
    ارجع نتيجة.ناجح(جدول_أنف)

# --- بحث بالفهرس عن قيمة (بلا مسح كامل) ---
صدر ابحث_بالفهرس
دالة ابحث_بالفهرس(جدول_ابف، عمود_ابف، قيمة_ابف):
    موجود_ابف = خطأ
    إذا عمود_ابف في جدول_ابف["فهارس"]:
        موجود_ابف = صحيح
    إذا ليس موجود_ابف:
        ارجع نتيجة.فاشل("لا فهرس على العمود " + عمود_ابف)
    نوع_ابف = جدول_ابف["أنواع"][عمود_ابف]
    إذا نوع(قيمة_ابف) != "لاشيء":
        إذا نوع(قيمة_ابف) != نوع_ابف:
            ارجع نتيجة.فاشل("نوع قيمة البحث لا يطابق العمود " + عمود_ابف)
    مفتاح_ابف = ترميز.شفّر_قيمة(قيمة_ابف)
    معرفات_ابف = فهرس.ابحث(جدول_ابف["فهارس"][عمود_ابف], مفتاح_ابف)
    نتائج_ابف = []
    لكل معرف_ابف في معرفات_ابف:
        موضع_ابف = بحث_ثنائي(جدول_ابف["صفوف"], معرف_ابف)
        إذا موضع_ابف >= ٠:
            صف_ابف = جدول_ابف["صفوف"][موضع_ابف]
            إذا "_محذوف" في صف_ابف:
                تابع
            نتائج_ابف.أضف(نسخة_صف(صف_ابف, جدول_ابف["أعمدة"]))
    ارجع نتيجة.ناجح(نتائج_ابف)

# --- حفظ الجدول على القرص (شظايا + فهارس، كتابة ذرية، دمج المحذوف) ---
صدر احفظ
دالة احفظ(جدول_احف):
    حية_احف = []
    لكل صف_احف في جدول_احف["صفوف"]:
        إذا "_محذوف" في صف_احف:
            تابع
        حية_احف.أضف(صف_احف)
    عدد_احف = طول(حية_احف)
    شظايا_احف = ٠
    بينما شظايا_احف * ١٠٠٠ < عدد_احف:
        شظايا_احف = شظايا_احف + ١
    ملفات_احف = []
    سطر_احف = ترميز.شفّر_مخطط(جدول_احف["اسم"], جدول_احف["أعمدة"], جدول_احف["أنواع"])
    ملفات_احف.أضف([جدول_احف["مسار"] + "/مخطط.جدول", سطر_احف + "\n"])
    رقم_احف = ١
    بينما رقم_احف <= شظايا_احف:
        محتوى_احف = ""
        عداد_احف = (رقم_احف - ١) * ١٠٠٠
        حد_احف = رقم_احف * ١٠٠٠
        إذا حد_احف > عدد_احف:
            حد_احف = عدد_احف
        بينما عداد_احف < حد_احف:
            محتوى_احف = محتوى_احف + ترميز.شفّر_صف(حية_احف[عداد_احف], جدول_احف["أعمدة"]) + "\n"
            عداد_احف = عداد_احف + ١
        ملفات_احف.أضف([جدول_احف["مسار"] + "/شظية-" + نص(رقم_احف) + ".جدول", محتوى_احف])
        رقم_احف = رقم_احف + ١
    لكل عمود_احف في جدول_احف["أعمدة_مفهرسة"]:
        نص_احف = فهرس.شفّر(جدول_احف["فهارس"][عمود_احف])
        ملفات_احف.أضف([جدول_احف["مسار"] + "/فهرس-" + عمود_احف + ".جدول", نص_احف])
    ظرف_احف = تخزين.اكتب_ملفات_ذرية(ملفات_احف)
    إذا ليس ظرف_احف["نجاح"]:
        ارجع نتيجة.فاشل(ظرف_احف["خطأ"])
    ظرف_احف = تخزين.سرد(جدول_احف["مسار"])
    إذا ظرف_احف["نجاح"]:
        لكل اسم_احف في ظرف_احف["قيمة"]:
            رقم_احف = رقم_شظية(اسم_احف)
            إذا رقم_احف > شظايا_احف:
                حاول:
                    احذف_ملف(جدول_احف["مسار"] + "/" + اسم_احف)
                ماعدا:
                    ارجع نتيجة.فاشل("تعذر حذف الشظية الزائدة " + اسم_احف)
    جدول_احف["صفوف"] = حية_احف
    جدول_احف["متسخ"] = خطأ
    ارجع نتيجة.ناجح(جدول_احف)
