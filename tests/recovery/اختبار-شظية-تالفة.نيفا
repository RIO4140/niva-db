# اختبار استرداد: شظية تالفة كاملة وفجوة في ترقيم الشظايا
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

ظرف = قاعدة.أدخل(جدول, {"اسم": "محمود", "عمر": ٢٣})
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.أدخل(جدول, {"اسم": "سارة", "عمر": ٢٥})
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.أدخل(جدول, {"اسم": "عمر", "عمر": ٣٠})
جدول = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "الحفظ الأول ينجح")
جدول = ظرف["قيمة"]

اكتب_ملف("قاعدة-اختبار/مستخدمون/شظية-٢.جدول", "٤|ليلى|٢٨\n٥|خالد|٣٢\n")
اكتب_ملف("قاعدة-اختبار/مستخدمون/شظية-٤.جدول", "٦|منى|٣٥\n")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "الفتح مع فجوة في ترقيم الشظايا ينجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ٦, "فجوة الترقيم لا توقف القراءة: ٦ صفوف")
تحقق(جدول٢["التالي"] == ٧, "التالي ٧")
تحقق(طول(جدول٢["تقرير"]) == ٠, "بلا ملاحظات مع الفجوة")

اكتب_ملف("قاعدة-اختبار/مستخدمون/شظية-٢.جدول", "قمامة كاملة بلا أنابيب\nسطر ثان تالف أيضا\n")
اكتب_ملف("قاعدة-اختبار/مستخدمون/شظية-٣.جدول", "٧|هند|ليس عددا\n")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "الفتح مع شظية تالفة كاملة ينجح")
جدول٣ = ظرف["قيمة"]
تحقق(طول(جدول٣["صفوف"]) == ٤, "السليم فقط: ٣ من الأولى + ١ من الرابعة")
تحقق(طول(جدول٣["تقرير"]) == ٣, "ثلاثة أسطر تالفة مسجلة")
تحقق(جدول٣["التالي"] == ٧, "التالي من أكبر معرف سليم")

ظرف = قاعدة.اختر(جدول٣, الكل)
تحقق(ظرف["قيمة"][٣]["اسم"] == "منى", "صف الشظية الرابعة سليم")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
