# اختبار استرداد: محاكاة قتل أثناء الكتابة — شظية ممزقة وملف مؤقت شارد
# القتل الحي لا يمكن اختباره داخل مشغّل نيفا (عمليات.أنشئ بلا وسائط
# ولا بحث PATH) — فهذا الاختبار يصنع يدويا الحالة التي يتركها القتل:
# شظية مقطوعة منتصف السطر + ملف مؤقت شارد، ويتحقق أن الفتح يسجّل
# ويسترد السليم. الإجراء اليدوي الكامل في docs/اختبار-القتل-يدويا.md.
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

عداد = ١
بينما عداد <= ٣:
    ظرف = قاعدة.أدخل(جدول, {"اسم": "مستخدم" + نص(عداد), "عمر": عداد * ١٠})
    جدول = ظرف["قيمة"]["جدول"]
    عداد = عداد + ١

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "الحفظ الأول ينجح")
جدول = ظرف["قيمة"]

تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/شظية-١.جدول.مؤقت")["نوع"] == "غير موجود", "لا ملفات مؤقتة بعد حفظ ناجح")

اكتب_ملف("قاعدة-اختبار/مستخدمون/شظية-١.جدول", "١|مستخدم١|١٠\n٢|مستخدم٢|٢٠\n٣|مستخدم")
اكتب_ملف("قاعدة-اختبار/مستخدمون/شظية-٢.جدول.مؤقت", "قمامة من قتل قديم")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "الفتح مع شظية ممزقة ينجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ٢, "السطران السليمان ينجوان والممزق يُتخطى")
تحقق(طول(جدول٢["تقرير"]) == ١, "السطر الممزق مسجل في التقرير")
تحقق(جدول٢["التالي"] == ٣, "التالي من أكبر معرف سليم")
تحقق(جدول٢["صفوف"][١]["اسم"] == "مستخدم٢", "الصف الثاني السليم كما هو")

ظرف = قاعدة.اختر(جدول٢, الكل)
تحقق(طول(ظرف["قيمة"]) == ٢, "الاختيار بعد الاسترداد يرجع صفين")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
