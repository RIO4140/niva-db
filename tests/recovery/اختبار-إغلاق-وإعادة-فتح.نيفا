# اختبار استرداد: إغلاق وإعادة فتح — المحفوظ يبقى وغير المحفوظ يضيع
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

عداد = ١
بينما عداد <= ٥٠:
    ظرف = قاعدة.أدخل(جدول, {"اسم": "مستخدم" + نص(عداد), "عمر": عداد})
    جدول = ظرف["قيمة"]["جدول"]
    عداد = عداد + ١

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "حفظ ٥٠ صفا ينجح")
جدول = ظرف["قيمة"]

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إعادة الفتح الأولى تنجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ٥٠, "٥٠ صفا بعد إعادة الفتح")
تحقق(جدول٢["التالي"] == ٥١, "التالي ٥١")

عداد = ٥١
بينما عداد <= ٦٠:
    ظرف = قاعدة.أدخل(جدول٢, {"اسم": "مستخدم" + نص(عداد), "عمر": عداد})
    جدول٢ = ظرف["قيمة"]["جدول"]
    عداد = عداد + ١
تحقق(طول(جدول٢["صفوف"]) == ٦٠, "٦٠ صفا في الذاكرة قبل الحفظ")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إعادة الفتح الثانية تنجح")
جدول٣ = ظرف["قيمة"]
تحقق(طول(جدول٣["صفوف"]) == ٥٠, "غير المحفوظ يضيع عند إعادة الفتح")
تحقق(جدول٣["التالي"] == ٥١, "التالي يعود إلى ٥١")

ظرف = قاعدة.احفظ(جدول٢)
تحقق(ظرف["نجاح"], "حفظ الستين ينجح")
جدول٢ = ظرف["قيمة"]

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(طول(ظرف["قيمة"]["صفوف"]) == ٦٠, "الستون كلهم بعد الحفظ وإعادة الفتح")
تحقق(ظرف["قيمة"]["التالي"] == ٦١, "التالي ٦١")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
