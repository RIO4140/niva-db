# اختبار وحدة: الترميز مباشرة — تشفير وفك وملف فهرس
استورد ترميز
استورد فهرس
استورد تخزين

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة عدد_فارغ():
    ارجع عدد("")

دالة قراءة_مفقود():
    ارجع اقرأ_ملف("ملف-غير-موجود-أبدا.txt")

تحقق(ترميز.شفّر_قيمة(لاشيء) == "\_", "تشفير لاشيء علامة")
تحقق(ترميز.شفّر_قيمة(٢٣) == "٢٣", "تشفير عدد صحيح")
تحقق(ترميز.شفّر_قيمة(١.٥) == "١.٥", "تشفير الكسر بنقطة لاتينية")
تحقق(ترميز.شفّر_قيمة(-٣.٥) == "-٣.٥", "تشفير الكسر السالب")
تحقق(ترميز.شفّر_قيمة(صحيح) == "صحيح", "تشفير صحيح")
تحقق(ترميز.شفّر_قيمة(خطأ) == "خطأ", "تشفير خطأ")
تحقق(ترميز.شفّر_قيمة("أ|ب") == "أ\|ب", "تشفير الأنبوب")
تحقق(ترميز.شفّر_قيمة("أ\nب") == "أ\\نب", "تشفير السطر الجديد")
تحقق(ترميز.شفّر_قيمة("أ\\ب") == "أ\\\\ب", "تشفير الشرطة المائلة مضاعفة")
تحقق(ترميز.شفّر_قيمة("أ\rب") == "أ\\رب", "تشفير إرجاع السطر")

ظرف = ترميز.فكّ_حقل("\_", "نص")
تحقق(ظرف["نجاح"], "فك علامة لاشيء ينجح")
تحقق(ظرف["قيمة"] == لاشيء, "فك علامة لاشيء يرجع لاشيء")
ظرف = ترميز.فكّ_حقل("٢٣", "عدد")
تحقق(ظرف["قيمة"] == ٢٣, "فك عدد صحيح")
ظرف = ترميز.فكّ_حقل("١.٥", "عدد")
تحقق(ظرف["قيمة"] == ١.٥, "فك كسر")
ظرف = ترميز.فكّ_حقل("صحيح", "منطقي")
تحقق(ظرف["قيمة"] == صحيح, "فك صحيح")
ظرف = ترميز.فكّ_حقل("أ\|ب", "نص")
تحقق(ظرف["قيمة"] == "أ|ب", "فك الأنبوب")
ظرف = ترميز.فكّ_حقل("أ\\نب", "نص")
تحقق(ظرف["قيمة"] == "أ\nب", "فك السطر الجديد")
ظرف = ترميز.فكّ_حقل("أ\\\\ب", "نص")
تحقق(ظرف["قيمة"] == "أ\\ب", "فك الشرطة المائلة")
ظرف = ترميز.فكّ_حقل("أ\\رب", "نص")
تحقق(ظرف["قيمة"] == "أ\rب", "فك إرجاع السطر")
ظرف = ترميز.فكّ_حقل("أ\س", "نص")
تحقق(ليس ظرف["نجاح"], "هرب غير صالح يفشل")
ظرف = ترميز.فكّ_حقل("أ\\", "نص")
تحقق(ليس ظرف["نجاح"], "شرطة وحيدة في النهاية تفشل")
ظرف = ترميز.فكّ_حقل("١٫٥", "عدد")
تحقق(ليس ظرف["نجاح"], "الفاصلة العربية في عدد تفشل")
ظرف = ترميز.فكّ_حقل("ليس عددا", "عدد")
تحقق(ليس ظرف["نجاح"], "نص ليس عددا يفشل")
ظرف = ترميز.فكّ_حقل("ربما", "منطقي")
تحقق(ليس ظرف["نجاح"], "نص ليس منطقيا يفشل")

حقول = ترميز.قسم_حقول("أ\|ب|ج")
تحقق(طول(حقول) == ٢, "تقسيم الحقول يحترم الهرب")
تحقق(حقول[٠] == "أ\|ب", "الحقل الأول يحمل هربه")
حقول = ترميز.قسم_حقول("أ||ب")
تحقق(طول(حقول) == ٣, "حقل فارغ في الوسط")
تحقق(حقول[١] == "", "الحقل الأوسط فارغ")

سطور = ترميز.قسم_سطور("أ\nب\n")
تحقق(طول(سطور) == ٢, "تقسيم السطور يسقط الأخير الفارغ")
سطور = ترميز.قسم_سطور("")
تحقق(طول(سطور) == ٠, "نص فارغ بلا سطور")
سطور = ترميز.قسم_سطور("أ\r\nب\r\n")
تحقق(سطور[٠] == "أ", "إرجاع السطر يجرّد من نهاية السطر")
تحقق(سطور[١] == "ب", "السطر الثاني بعد التجريد")

أعمدة = ["اسم", "عمر", "نشط"]
أنواع = {"اسم": "نص", "عمر": "عدد", "نشط": "منطقي"}
صف = {"_معرف": ٧, "اسم": "أ|ب", "عمر": ١.٥, "نشط": خطأ}
سطر = ترميز.شفّر_صف(صف, أعمدة)
تحقق(سطر == "٧|أ\|ب|١.٥|خطأ", "تشفير صف كامل")
ظرف = ترميز.فكّ_صف(سطر, أعمدة, أنواع)
تحقق(ظرف["نجاح"], "فك صف كامل ينجح")
تحقق(ظرف["قيمة"]["معرف"] == ٧, "معرف الصف المفكوك")
تحقق(ظرف["قيمة"]["صف"]["اسم"] == "أ|ب", "اسم الصف المفكوك")
تحقق(ظرف["قيمة"]["صف"]["عمر"] == ١.٥, "عمر الصف المفكوك")
تحقق(ظرف["قيمة"]["صف"]["نشط"] == خطأ, "نشط الصف المفكوك")
ظرف = ترميز.فكّ_صف("٧|أ|ب", أعمدة, أنواع)
تحقق(ليس ظرف["نجاح"], "صف بحقول ناقصة يفشل")
ظرف = ترميز.فكّ_صف("صفر|أ|١|صحيح", أعمدة, أنواع)
تحقق(ليس ظرف["نجاح"], "صف بمعرف غير عددي يفشل")

سطر_مخطط = ترميز.شفّر_مخطط("جدولي", أعمدة, أنواع)
تحقق(سطر_مخطط == "جدولي|اسم:نص|عمر:عدد|نشط:منطقي", "تشفير سطر المخطط")
ظرف = ترميز.فكّ_مخطط(سطر_مخطط)
تحقق(ظرف["نجاح"], "فك سطر المخطط ينجح")
تحقق(ظرف["قيمة"]["اسم"] == "جدولي", "اسم المخطط المفكوك")
تحقق(طول(ظرف["قيمة"]["أعمدة"]) == ٣, "أعمدة المخطط المفكوك")
تحقق(ظرف["قيمة"]["أنواع"]["عمر"] == "عدد", "نوع عمر في المخطط المفكوك")
ظرف = ترميز.فكّ_مخطط("جدولي|اسم")
تحقق(ليس ظرف["نجاح"], "عمود بلا نوع في المخطط يفشل")

فه = فهرس.جديد()
فه = فهرس.أضف(فه, "القاهرة", ١)
فه = فهرس.أضف(فه, "القاهرة", ٣)
فه = فهرس.أضف(فه, "الجيزة", ٢)
تحقق(طول(فهرس.ابحث(فه, "القاهرة")) == ٢, "الفهرس يجد معرفين")
تحقق(فهرس.ابحث(فه, "القاهرة")[٠] == ١, "أول معرف في الفهرس")
تحقق(طول(فهرس.ابحث(فه, "أسوان")) == ٠, "مفتاح غائب يرجع فارغا")
فه = فهرس.اسحب(فه, "القاهرة", ١)
تحقق(طول(فهرس.ابحث(فه, "القاهرة")) == ١, "السحب ينقص المعرفات")
تحقق(فهرس.ابحث(فه, "القاهرة")[٠] == ٣, "الباقي بعد السحب")
نص_فهرس = فهرس.شفّر(فه)
تحقق(نص_فهرس == "القاهرة|٣\nالجيزة|٢\n", "تشفير الفهرس إلى نص")
سطور_فهرس = ترميز.قسم_سطور(نص_فهرس)
ظرف = فهرس.فكّ(سطور_فهرس)
تحقق(ظرف["نجاح"], "فك نص الفهرس ينجح")
تحقق(طول(فهرس.ابحث(ظرف["قيمة"], "الجيزة")) == ١, "الفهرس المفكوك يجد الجيزة")
ظرف = فهرس.فكّ(["سطر بلا أنبوب"])
تحقق(ليس ظرف["نجاح"], "سطر فهرس بلا أنبوب يفشل")

تحقق_خطأ(عدد_فارغ, "عدد النص الفارغ يرفع خطأ")
تحقق_خطأ(قراءة_مفقود, "قراءة ملف مفقود ترفع خطأ")
ظرف = تخزين.اقرأ_آمن("ملف-غير-موجود-أبدا.txt")
تحقق(ليس ظرف["نجاح"], "القراءة الآمنة تحول الخطأ إلى ظرف")
تحقق(تخزين.يبدأ_ب("شظية-١.جدول", "شظية-"), "يبدأ_ب صحيح")
تحقق(ليس تخزين.يبدأ_ب("فهرس-عمر.جدول", "شظية-"), "يبدأ_ب خطأ")
تحقق(تخزين.ينتهي_ب("شظية-١.جدول", ".جدول"), "ينتهي_ب صحيح")
تحقق(ليس تخزين.ينتهي_ب("شظية-١.جدول", ".مؤقت"), "ينتهي_ب خطأ")

اختتم()
