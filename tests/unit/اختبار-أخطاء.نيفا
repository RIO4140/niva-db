# اختبار وحدة: أخطاء الإدخال والاستعلام كظروف فاشلة لا أعطال
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

دالة شرط_يخطئ(صف_اختبار):
    ارجع صف_اختبار["غائب"] > ١

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

ظرف = قاعدة.أدخل(جدول, {"اسم": "محمود", "عمر": ٢٣, "غائب": ١})
تحقق(ليس ظرف["نجاح"], "إدخال بعمود غريب يفشل")

ظرف = قاعدة.أدخل(جدول, {"اسم": "محمود", "عمر": "ثلاثة وعشرون"})
تحقق(ليس ظرف["نجاح"], "إدخال بنوع خاطئ يفشل")

ظرف = قاعدة.أدخل(جدول, {"اسم": "محمود", "عمر": ٢٣, "_معرف": ٩٩})
تحقق(ليس ظرف["نجاح"], "إدخال فيه _معرف يدوي يفشل")

صف_قائمة = ["محمود", ٢٣]
ظرف = قاعدة.أدخل(جدول, صف_قائمة)
تحقق(ليس ظرف["نجاح"], "إدخال صف ليس قاموسا يفشل")

ظرف = قاعدة.أدخل(جدول, {"اسم": "محمود"})
تحقق(ظرف["نجاح"], "إدخال بعمود ناقص ينجح")
جدول = ظرف["قيمة"]["جدول"]
تحقق(ظرف["قيمة"]["معرف"] == ١, "أول معرف ١")
ظرف = قاعدة.اختر(جدول, الكل)
تحقق(ظرف["قيمة"][٠]["عمر"] == لاشيء, "العمود الناقص يصير لاشيء")

ظرف = قاعدة.اختر(جدول, شرط_يخطئ)
تحقق(ليس ظرف["نجاح"], "شرط يخطئ أثناء الاختيار يفشل كظرف")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "جدول-غائب")
تحقق(ليس ظرف["نجاح"], "فتح جدول غائب يفشل")

ظرف = قاعدة.ابحث_بالفهرس(جدول, "عمر", ٢٣)
تحقق(ليس ظرف["نجاح"], "بحث بالفهرس على عمود بلا فهرس يفشل")

ظرف = قاعدة.أنشئ_فهرس(جدول, "عمر")
تحقق(ظرف["نجاح"], "إنشاء فهرس ينجح")
جدول = ظرف["قيمة"]
ظرف = قاعدة.ابحث_بالفهرس(جدول, "عمر", "ليس عددا")
تحقق(ليس ظرف["نجاح"], "بحث بالفهرس بنوع خاطئ يفشل")

تحقق(جدول["متسخ"] == صحيح, "الجدول متسخ بعد إنشاء الفهرس")
ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "الحفظ ينجح")
تحقق(ظرف["قيمة"]["متسخ"] == خطأ, "الجدول نظيف بعد الحفظ")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
