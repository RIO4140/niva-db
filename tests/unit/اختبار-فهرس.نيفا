# اختبار وحدة: الفهرس — بناء وصيانة وبحث يساوي المسح
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة مدينة_القاهرة(صف_اختبار):
    ارجع صف_اختبار["مدينة"] == "القاهرة"

دالة مدينة_أسوان(صف_اختبار):
    ارجع صف_اختبار["مدينة"] == "أسوان"

دالة عمر_٢٥(صف_اختبار):
    ارجع صف_اختبار["عمر"] == ٢٥

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["مدينة", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

مدن = ["القاهرة", "الجيزة", "الإسكندرية"]
عداد = ٠
بينما عداد < ٢٠:
    صف = {"اسم": "مستخدم" + نص(عداد + ١), "مدينة": مدن[عداد % ٣], "عمر": ٢٠ + عداد}
    ظرف = قاعدة.أدخل(جدول, صف)
    جدول = ظرف["قيمة"]["جدول"]
    عداد = عداد + ١

ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", "القاهرة")
تحقق(ليس ظرف["نجاح"], "البحث بلا فهرس يفشل")

ظرف = قاعدة.أنشئ_فهرس(جدول, "مدينة")
تحقق(ظرف["نجاح"], "إنشاء الفهرس ينجح")
جدول = ظرف["قيمة"]

ظرف = قاعدة.أنشئ_فهرس(جدول, "مدينة")
تحقق(ليس ظرف["نجاح"], "إنشاء فهرس موجود يفشل")

ظرف = قاعدة.أنشئ_فهرس(جدول, "غائب")
تحقق(ليس ظرف["نجاح"], "إنشاء فهرس على عمود غائب يفشل")

ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", "القاهرة")
تحقق(ظرف["نجاح"], "البحث بالفهرس ينجح")
تحقق(طول(ظرف["قيمة"]) == ٧, "الفهرس يجد ٧ صفوف للقاهرة")

ظرف٢ = قاعدة.اختر(جدول, مدينة_القاهرة)
تحقق(طول(ظرف["قيمة"]) == طول(ظرف٢["قيمة"]), "الفهرس يساوي المسح الكامل")

ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", "أسوان")
تحقق(طول(ظرف["قيمة"]) == ٠, "البحث عن قيمة غائبة يرجع صفرا")

ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", ٥)
تحقق(ليس ظرف["نجاح"], "البحث بنوع خاطئ يفشل")

صف = {"اسم": "جديد", "مدينة": "القاهرة", "عمر": ٩٩}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", "القاهرة")
تحقق(طول(ظرف["قيمة"]) == ٨, "الإدخال يحدّث الفهرس فورا")

ظرف = قاعدة.حدّث(جدول, مدينة_القاهرة, {"مدينة": "أسوان"})
تحقق(ظرف["قيمة"]["عدد"] == ٨, "التحديث غيّر مدينة ٨ صفوف")
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", "القاهرة")
تحقق(طول(ظرف["قيمة"]) == ٠, "الفهرس يعكس التحديث")
ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", "أسوان")
تحقق(طول(ظرف["قيمة"]) == ٨, "الفهرس يعكس القيمة الجديدة")

ظرف = قاعدة.احذف(جدول, مدينة_أسوان)
تحقق(ظرف["قيمة"]["عدد"] == ٨, "الحذف حذف ٨ صفوف")
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", "أسوان")
تحقق(طول(ظرف["قيمة"]) == ٠, "الفهرس يعكس الحذف")

ظرف = قاعدة.أنشئ_فهرس(جدول, "عمر")
تحقق(ظرف["نجاح"], "فهرس ثان على عمود عددي ينجح")
جدول = ظرف["قيمة"]
ظرف = قاعدة.ابحث_بالفهرس(جدول, "عمر", ٢٥)
ظرف٢ = قاعدة.اختر(جدول, عمر_٢٥)
تحقق(طول(ظرف["قيمة"]) == طول(ظرف٢["قيمة"]), "فهرس العدد يساوي المسح")

صف = {"اسم": "بلا مدينة", "مدينة": لاشيء, "عمر": ٤٠}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.ابحث_بالفهرس(جدول, "مدينة", لاشيء)
تحقق(طول(ظرف["قيمة"]) == ١, "البحث عن لاشيء بالفهرس يجد الصف")

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "الحفظ مع الفهارس ينجح")
جدول = ظرف["قيمة"]
تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/فهرس-مدينة.جدول")["نوع"] == "ملف", "ملف فهرس المدينة موجود")
تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/فهرس-عمر.جدول")["نوع"] == "ملف", "ملف فهرس العمر موجود")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إعادة الفتح مع الفهارس تنجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["تقرير"]) == ٠, "إعادة الفتح بلا ملاحظات")
ظرف = قاعدة.ابحث_بالفهرس(جدول٢, "مدينة", لاشيء)
تحقق(طول(ظرف["قيمة"]) == ١, "الفهرس يعاد بناؤه من الصفوف بعد الفتح")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
