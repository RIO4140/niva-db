# اختبار وحدة: تحديث وحذف منطقي ثم دمج
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

دالة عمر_٥٠_فأكثر(صف_اختبار):
    ارجع صف_اختبار["عمر"] >= ٥٠

دالة عمر_٣٠_فأقل(صف_اختبار):
    ارجع صف_اختبار["عمر"] <= ٣٠

دالة غير_نشط(صف_اختبار):
    ارجع صف_اختبار["نشط"] == خطأ

دالة شرط_يخطئ(صف_اختبار):
    ارجع صف_اختبار["غائب"] > ١

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"], ["نشط", "منطقي"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

عداد = ١
بينما عداد <= ١٠:
    صف = {"اسم": "مستخدم" + نص(عداد), "عمر": عداد * ١٠, "نشط": صحيح}
    ظرف = قاعدة.أدخل(جدول, صف)
    جدول = ظرف["قيمة"]["جدول"]
    عداد = عداد + ١

ظرف = قاعدة.حدّث(جدول, عمر_٥٠_فأكثر, {"نشط": خطأ})
تحقق(ظرف["نجاح"], "التحديث ينجح")
تحقق(ظرف["قيمة"]["عدد"] == ٦, "التحديث عدّل ٦ صفوف")
جدول = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.اختر(جدول, غير_نشط)
تحقق(طول(ظرف["قيمة"]) == ٦, "٦ صفوف صارت غير نشطة")

ظرف = قاعدة.اختر(جدول, عمر_٣٠_فأقل)
تحقق(ظرف["قيمة"][٠]["نشط"] == صحيح, "الصفوف غير المطابقة لم تتغير")

ظرف = قاعدة.حدّث(جدول, عمر_٥٠_فأكثر, {"عمر": "ليس عددا"})
تحقق(ليس ظرف["نجاح"], "تحديث بنوع خاطئ يفشل")

ظرف = قاعدة.حدّث(جدول, عمر_٥٠_فأكثر, {"غائب": ١})
تحقق(ليس ظرف["نجاح"], "تحديث بعمود غريب يفشل")

تغييرات_فارغة = {}
ظرف = قاعدة.حدّث(جدول, عمر_٥٠_فأكثر, تغييرات_فارغة)
تحقق(ليس ظرف["نجاح"], "تحديث بتغييرات فارغة يفشل")

ظرف = قاعدة.حدّث(جدول, شرط_يخطئ, {"نشط": صحيح})
تحقق(ليس ظرف["نجاح"], "شرط يخطئ أثناء التحديث يفشل كظرف")

ظرف = قاعدة.احذف(جدول, عمر_٣٠_فأقل)
تحقق(ظرف["نجاح"], "الحذف ينجح")
تحقق(ظرف["قيمة"]["عدد"] == ٣, "الحذف حذف ٣ صفوف")
جدول = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.اختر(جدول, الكل)
تحقق(طول(ظرف["قيمة"]) == ٧, "بقي ٧ صفوف بعد الحذف")

ظرف = قاعدة.احذف(جدول, عمر_٣٠_فأقل)
تحقق(ظرف["قيمة"]["عدد"] == ٠, "حذف ثان لنفس الشرط يجد صفرا")

ظرف = قاعدة.احذف(جدول, شرط_يخطئ)
تحقق(ليس ظرف["نجاح"], "شرط يخطئ أثناء الحذف يفشل كظرف")

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "الحفظ بعد الحذف ينجح")
جدول = ظرف["قيمة"]

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إعادة الفتح بعد الدمج تنجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ٧, "الدمج أسقط المحذوف نهائيا")
تحقق(جدول٢["التالي"] == ١١, "التالي بعد الدمج ١١")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
