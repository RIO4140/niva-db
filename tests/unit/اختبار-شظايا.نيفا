# اختبار وحدة: شظايا — 1001 صف في شظيتين ثم دمج وحذف زائدة
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

دالة عمر_١٠٠٠(صف_اختبار):
    ارجع صف_اختبار["عمر"] == ١٠٠٠

دالة عمر_صغير(صف_اختبار):
    ارجع صف_اختبار["عمر"] <= ٥

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

عداد = ١
بينما عداد <= ١٠٠١:
    صف = {"اسم": "مستخدم" + نص(عداد), "عمر": عداد}
    ظرف = قاعدة.أدخل(جدول, صف)
    جدول = ظرف["قيمة"]["جدول"]
    عداد = عداد + ١

تحقق(جدول["التالي"] == ١٠٠٢, "التالي بعد ١٠٠١ صف هو ١٠٠٢")

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "حفظ ١٠٠١ صف ينجح")
جدول = ظرف["قيمة"]
تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/شظية-١.جدول")["نوع"] == "ملف", "الشظية الأولى موجودة")
تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/شظية-٢.جدول")["نوع"] == "ملف", "الشظية الثانية موجودة")
تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/شظية-٣.جدول")["نوع"] == "غير موجود", "لا شظية ثالثة")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إعادة فتح الشظيتين تنجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ١٠٠١, "إعادة الفتح ترجع ١٠٠١ صف")
تحقق(جدول٢["التالي"] == ١٠٠٢, "التالي بعد إعادة الفتح ١٠٠٢")
تحقق(طول(جدول٢["تقرير"]) == ٠, "إعادة الفتح بلا ملاحظات")

ظرف = قاعدة.اختر(جدول٢, عمر_١٠٠٠)
تحقق(طول(ظرف["قيمة"]) == ١, "صف الشظية الثانية (عمر ١٠٠٠) موجود")
تحقق(ظرف["قيمة"][٠]["اسم"] == "مستخدم١٠٠٠", "اسم صف الشظية الثانية صحيح")

ظرف = قاعدة.احذف(جدول٢, عمر_صغير)
تحقق(ظرف["قيمة"]["عدد"] == ٥, "حذف ٥ صفوف من الشظية الأولى")
جدول٢ = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.احفظ(جدول٢)
تحقق(ظرف["نجاح"], "الحفظ بعد الحذف ينجح")
تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/شظية-٢.جدول")["نوع"] == "غير موجود", "الشظية الزائدة حُذفت بعد الدمج")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(طول(ظرف["قيمة"]["صفوف"]) == ٩٩٦, "بعد الدمج ٩٩٦ صفا")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
