# اختبار وحدة: إنشاء قاعدة وجدول والأخطاء
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

قاعدة.احذف_قاعدة("قاعدة-اختبار")

ظرف = قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
تحقق(ظرف["نجاح"], "إنشاء القاعدة ينجح")
تحقق(ظرف["قيمة"] == "قاعدة-اختبار", "إنشاء القاعدة يرجع اسمها")

ظرف = قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
تحقق(ليس ظرف["نجاح"], "إنشاء قاعدة موجودة يفشل")

ظرف = قاعدة.أنشئ_قاعدة("_سري")
