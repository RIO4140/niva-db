جدول = ظرف["قيمة"]
تحقق(جدول["اسم"] == "مستخدمون", "الجدول يحمل اسمه")
تحقق(طول(جدول["أعمدة"]) == ٣, "الجدول فيه ٣ أعمدة")
تحقق(جدول["أعمدة"][٠] == "اسم", "ترتيب الأعمدة محفوظ")
تحقق(جدول["أنواع"]["عمر"] == "عدد", "نوع العمود محفوظ")
تحقق(جدول["التالي"] == ١, "أول معرف هو ١")
تحقق(طول(جدول["صفوف"]) == ٠, "الجدول الجديد بلا صفوف")
تحقق(جدول["متسخ"] == خطأ, "الجدول الجديد غير متسخ")

