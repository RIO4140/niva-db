# اختبار وحدة: إدخال 100 صف وقراءتها
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

دالة عمر_فوق_٤٠(صف_اختبار):
    ارجع صف_اختبار["عمر"] > ٤٠

دالة اسم_خمسين(صف_اختبار):
    ارجع صف_اختبار["اسم"] == "مستخدم٥٠"

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"], ["نشط", "منطقي"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

عداد = ٠
بينما عداد < ١٠٠:
    نشط = خطأ
    إذا عداد % ٢ == ٠:
        نشط = صحيح
    صف = {"اسم": "مستخدم" + نص(عداد + ١), "عمر": ٢٠ + عداد % ٥٠, "نشط": نشط}
    ظرف = قاعدة.أدخل(جدول, صف)
    تحقق(ظرف["نجاح"], "إدخال صف ينجح")
    تحقق(ظرف["قيمة"]["معرف"] == عداد + ١, "المعرفات متسلسلة من ١")
    جدول = ظرف["قيمة"]["جدول"]
    عداد = عداد + ١

تحقق(جدول["التالي"] == ١٠١, "التالي بعد ١٠٠ صف هو ١٠١")
تحقق(جدول["متسخ"] == صحيح, "الجدول متسخ بعد الإدخال")

ظرف = قاعدة.اختر(جدول, الكل)
تحقق(ظرف["نجاح"], "اختيار الكل ينجح")
تحقق(طول(ظرف["قيمة"]) == ١٠٠, "اختيار الكل يرجع ١٠٠ صف")

ظرف = قاعدة.اختر(جدول, عمر_فوق_٤٠)
تحقق(طول(ظرف["قيمة"]) == ٥٨, "العمر فوق ٤٠ في ٥٨ صفا")

ظرف = قاعدة.اختر(جدول, اسم_خمسين)
تحقق(طول(ظرف["قيمة"]) == ١, "البحث بالاسم يرجع صفا واحدا")
تحقق(ظرف["قيمة"][٠]["عمر"] == ٦٩, "عمر مستخدم٥٠ هو ٦٩")

صف_مرجع = ظرف["قيمة"][٠]
صف_مرجع["اسم"] = "معدّل"
ظرف = قاعدة.اختر(جدول, اسم_خمسين)
تحقق(ظرف["قيمة"][٠]["اسم"] == "مستخدم٥٠", "الصفوف المرجَعة نسخ لا تمس الجدول")

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "الحفظ ينجح")
جدول = ظرف["قيمة"]
تحقق(جدول["متسخ"] == خطأ, "الجدول نظيف بعد الحفظ")
تحقق(تفاصيل_المسار("قاعدة-اختبار/مستخدمون/شظية-١.جدول")["نوع"] == "ملف", "ملف الشظية موجود بعد الحفظ")

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إعادة الفتح تنجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ١٠٠, "إعادة الفتح ترجع ١٠٠ صف")
تحقق(جدول٢["التالي"] == ١٠١, "التالي بعد إعادة الفتح ١٠١")
تحقق(طول(جدول٢["تقرير"]) == ٠, "إعادة الفتح بلا ملاحظات")

ظرف = قاعدة.اختر(جدول٢, اسم_خمسين)
تحقق(ظرف["قيمة"][٠]["عمر"] == ٦٩, "قيمة محفوظة تدور كاملة")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
