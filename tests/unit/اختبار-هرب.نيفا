# اختبار وحدة: هرب القيم — أنبوب وسطر جديد وشرطة مائلة وعلامة لاشيء
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["ملاحظة", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

صف = {"اسم": "أحمد|علي", "ملاحظة": "فيه أنبوب", "عمر": ٣٠}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

صف = {"اسم": "سارة", "ملاحظة": "سطر١\nسطر٢", "عمر": ٢٥}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

صف = {"اسم": "مسار\\ملف", "ملاحظة": "شرطة مائلة", "عمر": ٤٠}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

صف = {"اسم": "\\_نص", "ملاحظة": "تبدو كعلامة لاشيء", "عمر": ٣٥}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

صف = {"اسم": "", "ملاحظة": "", "عمر": ٢٠}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

صف = {"اسم": "أ\rb", "ملاحظة": "فيه إرجاع", "عمر": ٢٢}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

صف = {"اسم": "بلا عمر", "ملاحظة": لاشيء, "عمر": لاشيء}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

صف = {"اسم": "كسر", "ملاحظة": "عمر عشري", "عمر": ١.٥}
ظرف = قاعدة.أدخل(جدول, صف)
جدول = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "حفظ القيم المهربة ينجح")
جدول = ظرف["قيمة"]

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إعادة الفتح تنجح")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ٨, "كل الصفوف الثمانية عادت")
تحقق(طول(جدول٢["تقرير"]) == ٠, "إعادة الفتح بلا ملاحظات")

ظرف = قاعدة.اختر(جدول٢, الكل)
صفوف = ظرف["قيمة"]
تحقق(صفوف[٠]["اسم"] == "أحمد|علي", "الأنبوب يدور كما هو")
تحقق(صفوف[١]["ملاحظة"] == "سطر١\nسطر٢", "السطر الجديد يدور كما هو")
تحقق(صفوف[٢]["اسم"] == "مسار\\ملف", "الشرطة المائلة تدور كما هي")
تحقق(صفوف[٣]["اسم"] == "\\_نص", "النص الذي يبدو كعلامة لاشيء لا يصير لاشيء")
تحقق(صفوف[٤]["اسم"] == "", "النص الفارغ يدور فارغا")
تحقق(صفوف[٥]["اسم"] == "أ\rb", "إرجاع السطر يدور كما هو")
تحقق(صفوف[٦]["ملاحظة"] == لاشيء, "لاشيء في نص يدور لاشيء")
تحقق(صفوف[٦]["عمر"] == لاشيء, "لاشيء في عدد يدور لاشيء")
تحقق(صفوف[٧]["عمر"] == ١.٥, "الكسر ١.٥ يدور كما هو")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
