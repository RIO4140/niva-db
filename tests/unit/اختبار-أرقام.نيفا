# اختبار وحدة: الأرقام — دقة صحيحة حتى 9e15 وكسور وسالب
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["قيمة", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "أرقام", مخطط)
جدول = ظرف["قيمة"]

أرقام = [٠, ١, -١, ١.٥, -٣.٥, ٠.٠٠١, ١٠٠٠٠٠٠, ٩٠٠٧١٩٩٢٥٤٧٤٠٩٩١]
لكل رقم_اختبار في أرقام:
    ظرف = قاعدة.أدخل(جدول, {"قيمة": رقم_اختبار})
    تحقق(ظرف["نجاح"], "إدخال رقم ينجح")
    جدول = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "حفظ الأرقام ينجح")
جدول = ظرف["قيمة"]

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "أرقام")
تحقق(ظرف["نجاح"], "إعادة الفتح تنجح")
جدول٢ = ظرف["قيمة"]
ظرف = قاعدة.اختر(جدول٢, الكل)
صفوف = ظرف["قيمة"]
تحقق(طول(صفوف) == ٨, "ثمانية أرقام عادت")
تحقق(صفوف[٠]["قيمة"] == ٠, "الصفر يدور")
تحقق(صفوف[١]["قيمة"] == ١, "الواحد يدور")
تحقق(صفوف[٢]["قيمة"] == -١, "السالب يدور")
تحقق(صفوف[٣]["قيمة"] == ١.٥, "الكسر ١.٥ يدور")
تحقق(صفوف[٤]["قيمة"] == -٣.٥, "الكسر السالب يدور")
تحقق(صفوف[٥]["قيمة"] == ٠.٠٠١, "الكسر الصغير يدور")
تحقق(صفوف[٦]["قيمة"] == ١٠٠٠٠٠٠, "المليون يدور")
تحقق(صفوف[٧]["قيمة"] == ٩٠٠٧١٩٩٢٥٤٧٤٠٩٩١, "أكبر صحيح دقيق (2^53-1) يدور")

ظرف = قاعدة.أدخل(جدول٢, {"قيمة": ٩٠٠٧١٩٩٢٥٤٧٤٠٩٩٣})
تحقق(ظرف["نجاح"], "إدخال فوق حد الدقة لا يرفض")
جدول٢ = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.اختر(جدول٢, الكل)
تحقق(ظرف["قيمة"][٨]["قيمة"] == ٩٠٠٧١٩٩٢٥٤٧٤٠٩٩٢, "فوق 2^53 يدور إلى أقرب ممثل")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
