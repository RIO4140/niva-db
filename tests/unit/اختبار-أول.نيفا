# اختبار أول — كتابة جدول وقراءته والتحقق من محتواه
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل؛
# وسكربت التشغيل (tools/شغّل-الاختبارات.sh) هو الذي يحكم بالنتيجة.
استورد ملفات

معرف = ملفات.افتح "اختبار-أول.جدول"
ملفات.اكتب معرف "١|محمود|٢٣\n٢|سارة|٣٠"
محتوى = ملفات.اقرأ معرف
سطور = محتوى.قسم("\n")

إذا سطور.طول() == ٢:
  إذا سطور[٠] == "١|محمود|٢٣":
    إذا سطور[١] == "٢|سارة|٣٠":
      اطبع "ناجح"
    وإلا:
      اطبع "فاشل: الصف الثاني"
  وإلا:
    اطبع "فاشل: الصف الأول"
وإلا:
  اطبع "فاشل: عدد السطور"
