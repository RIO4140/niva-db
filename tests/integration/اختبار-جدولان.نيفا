# اختبار تكامل: جدولان وربط بينهما بلغة نيفا
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

دالة الكل(صف_اختبار):
    ارجع صحيح

دالة قسم_واحد(صف_اختبار):
    ارجع صف_اختبار["_معرف"] == ١

دالة قسم_اثنان(صف_اختبار):
    ارجع صف_اختبار["_معرف"] == ٢

دالة قسم_ثلاثة(صف_اختبار):
    ارجع صف_اختبار["_معرف"] == ٣

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "أقسام", [["اسم", "نص"]])
أقسام = ظرف["قيمة"]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "طلاب", [["اسم", "نص"], ["قسم", "عدد"]])
طلاب = ظرف["قيمة"]

أسماء_أقسام = ["هندسة", "طب", "حقوق"]
لكل اسم_اختبار في أسماء_أقسام:
    ظرف = قاعدة.أدخل(أقسام, {"اسم": اسم_اختبار})
    تحقق(ظرف["نجاح"], "إدخال قسم ينجح")
    أقسام = ظرف["قيمة"]["جدول"]

طلاب_بيانات = [["أحمد", ١], ["سارة", ٢], ["عمر", ١], ["ليلى", ٣], ["خالد", ٢], ["بلا قسم", ٩٩]]
لكل زوج_اختبار في طلاب_بيانات:
    ظرف = قاعدة.أدخل(طلاب, {"اسم": زوج_اختبار[٠], "قسم": زوج_اختبار[١]})
    تحقق(ظرف["نجاح"], "إدخال طالب ينجح")
    طلاب = ظرف["قيمة"]["جدول"]

ظرف = قاعدة.احفظ(أقسام)
تحقق(ظرف["نجاح"], "حفظ الأقسام ينجح")
أقسام = ظرف["قيمة"]
ظرف = قاعدة.احفظ(طلاب)
تحقق(ظرف["نجاح"], "حفظ الطلاب ينجح")
طلاب = ظرف["قيمة"]

ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "أقسام")
تحقق(ظرف["نجاح"], "إعادة فتح الأقسام تنجح")
أقسام٢ = ظرف["قيمة"]
ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "طلاب")
تحقق(ظرف["نجاح"], "إعادة فتح الطلاب تنجح")
طلاب٢ = ظرف["قيمة"]

ظرف = قاعدة.اختر(طلاب٢, الكل)
صفوف_طلاب = ظرف["قيمة"]
تحقق(طول(صفوف_طلاب) == ٦, "ستة طلاب بعد إعادة الفتح")

نتائج_ربط = []
لكل طالب_اختبار في صفوف_طلاب:
    إذا طالب_اختبار["قسم"] == ١:
        ظرف = قاعدة.اختر(أقسام٢, قسم_واحد)
    وإلا إذا طالب_اختبار["قسم"] == ٢:
        ظرف = قاعدة.اختر(أقسام٢, قسم_اثنان)
    وإلا إذا طالب_اختبار["قسم"] == ٣:
        ظرف = قاعدة.اختر(أقسام٢, قسم_ثلاثة)
    وإلا:
        ظرف = {"نجاح": صحيح, "قيمة": [], "خطأ": ""}
    إذا طول(ظرف["قيمة"]) == ١:
        زوج_ربط = []
        زوج_ربط.أضف(طالب_اختبار["اسم"])
        زوج_ربط.أضف(ظرف["قيمة"][٠]["اسم"])
        نتائج_ربط.أضف(زوج_ربط)

تحقق(طول(نتائج_ربط) == ٥, "الربط يطابق ٥ طلاب ويستثني بلا قسم")
تحقق(نتائج_ربط[٠][٠] == "أحمد", "أول طالب في الربط")
تحقق(نتائج_ربط[٠][١] == "هندسة", "قسم أحمد هندسة")
تحقق(نتائج_ربط[١][١] == "طب", "قسم سارة طب")
تحقق(نتائج_ربط[٣][١] == "حقوق", "قسم ليلى حقوق")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
