# اختبار تكامل: مخطط تالف يدويا — الفتح يفشل أو يسجل ولا يوقف القاعدة
استورد قاعدة

حالة_اختبار = {"ناجح": ٠, "فاشل": ٠}

دالة تحقق(شرط_اختبار، وصف_اختبار):
    إذا شرط_اختبار:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
    وإلا:
        حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
        اطبع "فشل: " + وصف_اختبار

دالة تحقق_خطأ(دالة_اختبار، وصف_اختبار):
    حاول:
        دالة_اختبار()
    ماعدا:
        حالة_اختبار["ناجح"] = حالة_اختبار["ناجح"] + ١
        ارجع لاشيء
    حالة_اختبار["فاشل"] = حالة_اختبار["فاشل"] + ١
    اطبع "فشل (لم يرفع خطأ): " + وصف_اختبار

دالة اختتم():
    إذا حالة_اختبار["فاشل"] == ٠:
        اطبع "ناجح"
    وإلا:
        اطبع "فشل: " + نص(حالة_اختبار["فاشل"]) + " تأكيدات من " + نص(حالة_اختبار["ناجح"] + حالة_اختبار["فاشل"])

قاعدة.احذف_قاعدة("قاعدة-اختبار")
قاعدة.أنشئ_قاعدة("قاعدة-اختبار")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-اختبار", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]
ظرف = قاعدة.أدخل(جدول, {"اسم": "محمود", "عمر": ٢٣})
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.أدخل(جدول, {"اسم": "سارة", "عمر": ٢٥})
جدول = ظرف["قيمة"]["جدول"]
ظرف = قاعدة.احفظ(جدول)
تحقق(ظرف["نجاح"], "الحفظ الأول ينجح")
جدول = ظرف["قيمة"]

اكتب_ملف("قاعدة-اختبار/مستخدمون/مخطط.جدول", "مستخدمون|اسم|عمر:عدد\n")
ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ليس ظرف["نجاح"], "عمود بلا نوع في المخطط يفشل الفتح")

اكتب_ملف("قاعدة-اختبار/مستخدمون/مخطط.جدول", "آخر|اسم:نص|عمر:عدد\n")
ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ليس ظرف["نجاح"], "اسم مخطط لا يطابق الجدول يفشل الفتح")

اكتب_ملف("قاعدة-اختبار/مستخدمون/مخطط.جدول", "مستخدمون|اسم:نص\n")
ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "مخطط بعمود ناقص يفتح الجدول مع تسجيل")
جدول٢ = ظرف["قيمة"]
تحقق(طول(جدول٢["صفوف"]) == ٠, "الصفوف ذات الحقول الزائدة تُتخطى")
تحقق(طول(جدول٢["تقرير"]) > ٠, "التخطي مسجل في التقرير")

اكتب_ملف("قاعدة-اختبار/مستخدمون/مخطط.جدول", "مستخدمون|اسم:نص|عمر:عدد\n")
ظرف = قاعدة.افتح_جدول("قاعدة-اختبار", "مستخدمون")
تحقق(ظرف["نجاح"], "إصلاح المخطط يعيد الفتح")
تحقق(طول(ظرف["قيمة"]["صفوف"]) == ٢, "الصفان عادا بعد إصلاح المخطط")
تحقق(طول(ظرف["قيمة"]["تقرير"]) == ٠, "بلا ملاحظات بعد الإصلاح")

قاعدة.احذف_قاعدة("قاعدة-اختبار")

اختتم()
