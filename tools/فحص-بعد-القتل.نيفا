# فحص قاعدة بعد القتل — يطبع نجاح الفتح والصفوف والتقرير
# التشغيل بعد kill -9: نيفا tools/فحص-بعد-القتل.نيفا
استورد قاعدة

ظرف = قاعدة.افتح_جدول("قاعدة-قتل", "مستخدمون")
اطبع ظرف["نجاح"]
اطبع ظرف["خطأ"]
إذا ظرف["نجاح"]:
    جدول = ظرف["قيمة"]
    اطبع طول(جدول["صفوف"])
    اطبع جدول["تقرير"]
    اطبع جدول["التالي"]
