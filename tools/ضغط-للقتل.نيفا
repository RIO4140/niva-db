# برنامج ضغط لاختبار القتل — يدخل ويحفظ بدفعات حتى يُقتل
# التشغيل: نيفا tools/ضغط-للقتل.نيفا
# (يُقتل من طرفية أخرى بـ kill -9؛ انظر docs/اختبار-القتل-يدويا.md)
استورد قاعدة

قاعدة.احذف_قاعدة("قاعدة-قتل")
قاعدة.أنشئ_قاعدة("قاعدة-قتل")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-قتل", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

دفعة = ١
بينما دفعة <= ١٠٠:
    عداد = ١
    بينما عداد <= ١٠٠٠:
        رقم = (دفعة - ١) * ١٠٠٠ + عداد
        ظرف = قاعدة.أدخل(جدول, {"اسم": "مستخدم" + نص(رقم), "عمر": رقم})
        جدول = ظرف["قيمة"]["جدول"]
        عداد = عداد + ١
    ظرف = قاعدة.احفظ(جدول)
    جدول = ظرف["قيمة"]
    اطبع "حفظت الدفعة " + نص(دفعة)
    دفعة = دفعة + ١
اطبع "تم"
