# قياس أداء NivaDB Core v0.1 — خط الأساس المنشور
# التشغيل: نيفا tools/قياس-الأداء.نيفا
# ثم: نيفا --مفسر tools/قياس-الأداء.نيفا
# النتائج في docs/قياس-الأداء.md مع وصف الجهاز.
استورد قاعدة
استورد وقت

دالة الكل(صف_قياس):
    ارجع صحيح

دالة عمر_٥٠٠٠(صف_قياس):
    ارجع صف_قياس["عمر"] == ٥٠٠٠

قاعدة.احذف_قاعدة("قاعدة-قياس")
قاعدة.أنشئ_قاعدة("قاعدة-قياس")
مخطط = [["اسم", "نص"], ["عمر", "عدد"]]
ظرف = قاعدة.أنشئ_جدول("قاعدة-قياس", "مستخدمون", مخطط)
جدول = ظرف["قيمة"]

بداية = وقت.الآن()
عداد = ١
ألف = ١٠٠٠
بينما عداد <= ١٠٠٠٠:
    ظرف = قاعدة.أدخل(جدول, {"اسم": "مستخدم" + نص(عداد), "عمر": عداد})
    جدول = ظرف["قيمة"]["جدول"]
    إذا عداد == ألف:
        اطبع "وصلنا إلى " + نص(عداد) + " صف في " + نص(وقت.الآن() - بداية) + " ثانية"
        ألف = ألف + ١٠٠٠
    عداد = عداد + ١
نهاية = وقت.الآن()
اطبع "إدخال ١٠٠٠٠ صف: " + نص(نهاية - بداية) + " ثانية"

بداية = وقت.الآن()
ظرف = قاعدة.احفظ(جدول)
جدول = ظرف["قيمة"]
نهاية = وقت.الآن()
اطبع "حفظ ١٠٠٠٠ صف: " + نص(نهاية - بداية) + " ثانية"

بداية = وقت.الآن()
ظرف = قاعدة.افتح_جدول("قاعدة-قياس", "مستخدمون")
جدول٢ = ظرف["قيمة"]
نهاية = وقت.الآن()
اطبع "إعادة فتح ١٠٠٠٠ صف: " + نص(نهاية - بداية) + " ثانية"
اطبع "الصفوف بعد إعادة الفتح: " + نص(طول(جدول٢["صفوف"]))

بداية = وقت.الآن()
تكرار = ٠
بينما تكرار < ١٠:
    ظرف = قاعدة.اختر(جدول٢, عمر_٥٠٠٠)
    تكرار = تكرار + ١
نهاية = وقت.الآن()
اطبع "مسح كامل (١٠ مرات، عمر ٥٠٠٠): " + نص(نهاية - بداية) + " ثانية"
اطبع "نتائج المسح: " + نص(طول(ظرف["قيمة"]))

ظرف = قاعدة.أنشئ_فهرس(جدول٢, "عمر")
جدول٢ = ظرف["قيمة"]

بداية = وقت.الآن()
تكرار = ٠
بينما تكرار < ١٠٠:
    ظرف = قاعدة.ابحث_بالفهرس(جدول٢, "عمر", ٥٠٠٠)
    تكرار = تكرار + ١
نهاية = وقت.الآن()
اطبع "بحث بالفهرس (١٠٠ مرة، عمر ٥٠٠٠): " + نص(نهاية - بداية) + " ثانية"
اطبع "نتائج الفهرس: " + نص(طول(ظرف["قيمة"]))

قاعدة.احذف_قاعدة("قاعدة-قياس")
اطبع "تم"
